<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log Aktivitas - Admin | Telkom Akses</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        :root { --navy:#0e1f3b; --navy2:#162d52; --red:#EE2E24; --red2:#c42019; --surface:#f0f4f8; --card:#fff; --border:#dde3ec; --text:#1e293b; --muted:#64748b; }
        body { font-family:'Poppins',sans-serif; background:var(--surface); color:var(--text); overflow-x:hidden; }
        .navbar-custom { background:linear-gradient(135deg,var(--navy),var(--navy2)); border-bottom:3px solid var(--red); }
        .navbar-brand-logo { background:var(--red); border-radius:8px; padding:4px 10px; font-weight:800; font-size:.9rem; }
        .card-panel { background:var(--card); border-radius:20px; border:1px solid var(--border); box-shadow:0 2px 16px rgba(14,31,59,.05); }
        .table th { background:var(--navy); color:rgba(255,255,255,.88); font-size:.72rem; text-transform:uppercase; letter-spacing:.5px; font-weight:600; border:none; }
        .table td { font-size:.82rem; border-color:#f1f5f9; vertical-align:middle; }
        .table tbody tr:hover { background:#fafbff; }
        .aksipill { display:inline-block; padding:3px 10px; border-radius:999px; font-size:.7rem; font-weight:700; }
        .badge-LOGIN { background:#dcfce7; color:#166534; }
        .badge-LOGOUT, .badge-SUBMIT_BAST { background:#e0f2fe; color:#075985; }
        .badge-APPROVE { background:#dcfce7; color:#166534; }
        .badge-TOLAK, .badge-LOGIN_GAGAL, .badge-LOGIN_BLOKIR { background:#fee2e2; color:#991b1b; }
        .badge-DELETE_USER, .badge-CANCEL_BAST { background:#fee2e2; color:#991b1b; }
        .badge-ADD_USER, .badge-RESET_PW, .badge-UPDATE_USER, .badge-UPDATE_BAST, .badge-BACKUP { background:#fef9c3; color:#854d0e; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3 mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/admin/dashboard">
            <span class="navbar-brand-logo">BAST</span>
            <span class="fw-bold fs-6 text-white opacity-90">Telkom Akses</span>
        </a>
        <div class="d-flex align-items-center gap-2">
            <a href="/admin/dashboard" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold"><i class="bi bi-arrow-left me-1"></i> Kembali</a>
            <a href="/admin/audit" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold"><i class="bi bi-arrow-clockwise me-1"></i> Muat Ulang</a>
            <a href="/logout" class="btn btn-sm btn-danger rounded-pill px-3 fw-semibold">Logout</a>
        </div>
    </div>
</nav>

<div class="container-fluid px-4 mb-5">
    <div class="card-panel p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h5 class="fw-bold mb-1"><i class="bi bi-journal-text text-danger me-2"></i> Log Aktivitas (Audit Trail)</h5>
                <p class="text-muted small mb-0">Catatan login, persetujuan, penolakan, dan perubahan akun. Menampilkan 200 entri terbaru.</p>
            </div>
            <div class="input-group" style="max-width:300px;">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" id="auditSearch" placeholder="Cari user / aksi..." oninput="filterAudit()">
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="auditTable">
                <thead>
                    <tr><th>#</th><th>Waktu</th><th>User</th><th>Role</th><th>Aksi</th><th>Detail</th></tr>
                </thead>
                <tbody>
                    <% if (!logs || logs.length === 0) { %>
                        <tr><td colspan="6" class="text-center text-muted py-4">Belum ada aktivitas tercatat.</td></tr>
                    <% } %>
                    <% logs.forEach(l => { %>
                    <tr>
                        <td class="text-muted"><%= l.id %></td>
                        <td class="font-monospace" style="font-size:.76rem;"><%= l.waktu %></td>
                        <td><%= l.username %></td>
                        <td><%= l.role %></td>
                        <td><span class="aksipill badge-<%= l.aksi %>"><%= l.aksi %></span></td>
                        <td class="text-muted"><%= l.detail || '-' %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function filterAudit() {
        const kw = document.getElementById('auditSearch').value.toLowerCase().trim();
        document.querySelectorAll('#auditTable tbody tr').forEach(tr => {
            tr.style.display = (!kw || tr.textContent.toLowerCase().includes(kw)) ? '' : 'none';
        });
    }
</script>
</body>
</html>
