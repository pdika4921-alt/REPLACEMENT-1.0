<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - TELKOM AKSES</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#EE2E24">
    <style>
    :root {
        --navy:   #0e1f3b;
        --navy2:  #162d52;
        --red:    #EE2E24;
        --red2:   #c42019;
        --gold:   #f59e0b;
        --surface:#f0f4f8;
        --card:   #ffffff;
        --border: #dde3ec;
        --text:   #1e293b;
        --muted:  #64748b;
    }

    body { font-family: 'Poppins', sans-serif; background: var(--surface); color: var(--text); }

    /* ---- NAVBAR ---- */
    .navbar-custom {
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
        border-bottom: 3px solid var(--red);
    }
    .navbar-brand-logo {
        background: var(--red);
        border-radius: 8px;
        padding: 4px 10px;
        font-weight: 800;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
    }

    /* ---- STAT CARDS ---- */
    .stat-card {
        border-radius: 16px;
        border: 1px solid var(--border);
        background: var(--card);
        box-shadow: 0 2px 12px rgba(14,31,59,0.07);
        transition: transform .25s, box-shadow .25s;
        overflow: hidden;
        position: relative;
    }
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
    }
    .stat-card.blue::before  { background: #3b82f6; }
    .stat-card.green::before { background: #22c55e; }
    .stat-card.amber::before { background: var(--gold); }
    .stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(14,31,59,0.12); }

    .stat-icon {
        width: 52px; height: 52px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem;
    }
    .stat-icon.blue  { background: #eff6ff; color: #3b82f6; }
    .stat-icon.green { background: #f0fdf4; color: #22c55e; }
    .stat-icon.amber { background: #fffbeb; color: var(--gold); }

    /* ---- TAB PILLS ---- */
    .tab-bar {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 6px;
        display: inline-flex;
        gap: 4px;
        box-shadow: 0 2px 8px rgba(14,31,59,0.05);
    }
    .tab-bar .nav-link {
        color: var(--muted);
        font-weight: 500;
        font-size: 0.85rem;
        border-radius: 10px;
        padding: 8px 18px;
        transition: all .2s;
        border: 1px solid transparent;
    }
    .tab-bar .nav-link:hover { color: var(--red); background: #fff5f5; }
    .tab-bar .nav-link.active {
        background: var(--navy);
        color: #fff;
        border-color: var(--navy);
        box-shadow: 0 3px 10px rgba(14,31,59,0.25);
    }
    .tab-bar .nav-link.active.special {
        background: linear-gradient(135deg, var(--navy) 0%, #1e4080 100%);
    }

    /* ---- CARD PANEL ---- */
    .card-panel {
        background: var(--card);
        border-radius: 20px;
        border: 1px solid var(--border);
        box-shadow: 0 2px 16px rgba(14,31,59,0.05);
    }

    /* ---- TABLE ---- */
    .table th {
        background: var(--navy);
        color: rgba(255,255,255,0.85);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        font-weight: 600;
        border: none;
    }
    .table td { border-color: #f1f5f9; vertical-align: middle; font-size: 0.875rem; }
    .table tbody tr:hover { background: #fafbff; }

    /* ---- BADGE STATUS ---- */
    .badge-completed { background:#dcfce7; color:#166534; padding:5px 14px; border-radius:20px; font-weight:600; font-size:0.73rem; display:inline-block; }
    .badge-pending   { background:#fef9c3; color:#854d0e; padding:5px 14px; border-radius:20px; font-weight:600; font-size:0.73rem; display:inline-block; }
    .badge-rejected  { background:#fee2e2; color:#991b1b; padding:5px 14px; border-radius:20px; font-weight:600; font-size:0.73rem; display:inline-block; }

    /* ---- TECHNICIAN ACCORDION ---- */
    .technician-card {
        border: 1px solid var(--border);
        border-radius: 14px;
        margin-bottom: 10px;
        overflow: hidden;
        background: var(--card);
        transition: box-shadow .2s;
    }
    .technician-card:hover { box-shadow: 0 4px 16px rgba(238,46,36,0.08); border-color: #fca5a5; }
    .technician-header {
        background: #f8fafc;
        padding: 16px 22px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: background .2s;
    }
    .technician-header:hover { background: #fff8f8; }

    /* ---- FORM CARDS (tab akun) ---- */
    .form-card {
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        box-shadow: 0 2px 12px rgba(14,31,59,0.05);
    }
    .form-card .card-header-custom {
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
        border-radius: 16px 16px 0 0;
        padding: 18px 24px;
        color: #fff;
    }
    .form-control, .form-select {
        border-radius: 10px;
        border: 1.5px solid var(--border);
        font-size: 0.875rem;
        transition: border-color .2s, box-shadow .2s;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--red);
        box-shadow: 0 0 0 3px rgba(238,46,36,0.1);
    }

    /* ---- ROLE SELECTOR (toggle btn) ---- */
    .role-toggle { display: flex; gap: 8px; }
    .role-toggle input[type=radio] { display: none; }
    .role-toggle label {
        flex: 1; text-align: center; padding: 9px 0; border-radius: 10px;
        border: 1.5px solid var(--border); cursor: pointer; font-size: 0.85rem;
        font-weight: 600; color: var(--muted); transition: all .2s;
    }
    .role-toggle input[type=radio]:checked + label {
        border-color: var(--red); background: #fff0f0; color: var(--red);
        box-shadow: 0 2px 8px rgba(238,46,36,0.15);
    }
    .role-toggle label i { display: block; font-size: 1.3rem; margin-bottom: 3px; }

    /* ---- AVATAR INITIAL ---- */
    .avatar-initial {
        width: 42px; height: 42px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 1rem; flex-shrink: 0;
    }
    .avatar-navy { background: var(--navy); color: #fff; }
    .avatar-red  { background: var(--red);  color: #fff; }

    /* ---- BTN STYLES ---- */
    .btn-navy {
        background: var(--navy); color: #fff; border: none;
        border-radius: 10px; font-weight: 600; font-size: 0.875rem;
        padding: 10px 22px; transition: background .2s, transform .15s;
    }
    .btn-navy:hover { background: var(--navy2); color: #fff; transform: translateY(-1px); }
    .btn-red {
        background: var(--red); color: #fff; border: none;
        border-radius: 10px; font-weight: 600; font-size: 0.875rem;
        padding: 10px 22px; transition: background .2s, transform .15s;
    }
    .btn-red:hover { background: var(--red2); color: #fff; transform: translateY(-1px); }

    /* ---- USER LIST ITEM ---- */
    .user-item {
        display: flex; align-items: center; gap: 14px;
        padding: 12px 16px; border-radius: 12px;
        border: 1px solid var(--border); background: #fafbff;
        margin-bottom: 8px; transition: border-color .2s;
    }
    .user-item:hover { border-color: #c7d2fe; }
    .user-item .user-meta { flex: 1; min-width: 0; }
    .user-item .user-meta .username { font-weight: 700; font-size: 0.9rem; color: var(--text); }
    .user-item .user-meta .nik { font-size: 0.75rem; color: var(--muted); font-family: monospace; }
    .user-item .user-meta .sto-badge { font-size: 0.68rem; padding: 2px 6px; border-radius: 6px; background: #e2e8f0; color: #475569; font-weight: 600; margin-left: 6px;}
    .user-item .user-meta .sa-badge { font-size: 0.65rem; padding: 2px 7px; border-radius: 6px; background: #eff6ff; color: #1d4ed8; font-weight: 700; margin-left: 4px; white-space: nowrap;}
    .user-item .user-meta .sa-badge i { font-size: 0.6rem; margin-right: 3px; }

    .badge-role-teknisi { background:#eff6ff; color:#1d4ed8; padding:3px 10px; border-radius:8px; font-size:0.72rem; font-weight:700; }
    .badge-role-wh      { background:#fdf4ff; color:#7c3aed; padding:3px 10px; border-radius:8px; font-size:0.72rem; font-weight:700; }

    /* ---- SECTION DIVIDER ---- */
    .section-label {
        font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 1px; color: var(--muted); margin: 16px 0 8px;
        display: flex; align-items: center; gap: 8px;
    }
    .section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* ---- STAT SUMMARY (rekap) ---- */
    .sum-stat {
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--card);
        padding: 14px 18px;
        box-shadow: 0 2px 10px rgba(14,31,59,0.05);
        transition: transform .2s, box-shadow .2s;
    }
    .sum-stat:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(14,31,59,0.1); }
    .sum-stat .sum-label { font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.6px; color:var(--muted); }
    .sum-stat .sum-value { font-size:1.6rem; font-weight:800; line-height:1.1; color:var(--navy); }
    .sum-stat .sum-icon { width:38px; height:38px; border-radius:11px; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
    .sum-blue  { background:#eff6ff; color:#3b82f6; }
    .sum-green { background:#f0fdf4; color:#22c55e; }
    .sum-amber { background:#fffbeb; color:#f59e0b; }
    .sum-red   { background:#fef2f2; color:#ef4444; }

    /* ---- TECH BADGES (rekap) ---- */
    .tech-badge {
        display:inline-block; font-size:0.7rem; font-weight:600; padding:3px 10px;
        border-radius:20px; white-space:nowrap;
    }
    .tech-badge.sto { background:#e2e8f0; color:#334155; }
    .tech-badge.sa  { background:#eff6ff; color:#1d4ed8; }

    /* ===== EXTRA ANIMATIONS ===== */
    body { overflow-x: hidden; }

    .bg-deco { position: fixed; border-radius: 50%; filter: blur(60px); opacity: .15; pointer-events: none; z-index: 0; }
    .bg-deco.d1 { width: 400px; height: 400px; top: -90px; right: -80px; background: var(--red); animation: floatBlob 12s ease-in-out infinite; }
    .bg-deco.d2 { width: 320px; height: 320px; bottom: -90px; left: -80px; background: var(--navy); animation: floatBlob 14s ease-in-out 2.2s infinite; }
    .bg-deco.d3 { width: 200px; height: 200px; top: 45%; left: 10%; background: var(--gold); opacity: .1; animation: floatBlob 16s ease-in-out 3s infinite; }

    .navbar, .container-fluid { position: relative; z-index: 1; }

    @keyframes floatBlob { 0%, 100% { transform: translate(0,0) scale(1); } 50% { transform: translate(26px,-22px) scale(1.07); } }
    @keyframes shineSweep { 0% { left: -60%; } 60%, 100% { left: 130%; } }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }

    .anim-up { opacity: 0; animation: fadeUp .6s cubic-bezier(.22,1,.36,1) both; }

    /* Sapuan cahaya pada kartu statistik */
    .stat-card { position: relative; overflow: hidden; }
    .stat-card::after {
        content: ''; position: absolute; top: 0; bottom: 0; width: 40%;
        background: linear-gradient(105deg, transparent, rgba(255,255,255,.55), transparent);
        transform: skewX(-20deg); animation: shineSweep 5s ease-in-out infinite;
        pointer-events: none;
    }

    /* Scroll reveal */
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity .6s cubic-bezier(.22,1,.36,1), transform .6s cubic-bezier(.22,1,.36,1); }
    .reveal.reveal-visible { opacity: 1; transform: none; }

    /* Tab pill */
    .tab-bar .nav-link { transition: all .25s; }
    .tab-bar .nav-link:hover { transform: translateY(-2px); }

    /* Baris tabel masuk bertahap */
    .table tbody tr { animation: rowIn .45s cubic-bezier(.22,1,.36,1) both; }
    .table tbody tr:nth-child(2) { animation-delay: .05s; }
    .table tbody tr:nth-child(3) { animation-delay: .1s; }
    .table tbody tr:nth-child(4) { animation-delay: .15s; }
    .table tbody tr:nth-child(5) { animation-delay: .2s; }
    .table tbody tr:nth-child(6) { animation-delay: .25s; }
    .table tbody tr:nth-child(7) { animation-delay: .3s; }
    .table tbody tr:nth-child(8) { animation-delay: .35s; }
    .table tbody tr:nth-child(n+9) { animation-delay: .4s; }
    @keyframes rowIn { from { opacity: 0; transform: translateX(-12px); } to { opacity: 1; transform: translateX(0); } }

    /* Hover lift */
    .card-panel, .stat-card, .technician-card { transition: transform .2s, box-shadow .25s; }
    .card-panel:hover, .technician-card:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(14,31,59,.1); }

    /* Tombol download berdenyut */
    .btn-success { animation: pulseGreen 2.6s ease-in-out infinite; }
    @keyframes pulseGreen { 0%, 100% { box-shadow: 0 6px 16px rgba(34,197,94,.25); } 50% { box-shadow: 0 8px 26px rgba(34,197,94,.45); } }

    /* Ikon stat */
    .stat-icon { transition: transform .3s ease; }
    .stat-card:hover .stat-icon { transform: scale(1.18) rotate(-6deg); }

    /* Judul gradien bergerak */
    .title-gradient {
        background: linear-gradient(90deg, var(--navy), var(--red), var(--gold), var(--navy));
        background-size: 300% 100%;
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradMove 6s linear infinite;
    }
    @keyframes gradMove { 0% { background-position: 0% 50%; } 100% { background-position: 300% 50%; } }

    @media (prefers-reduced-motion: reduce) {
        .bg-deco, .stat-card::after, .btn-success, .table tbody tr, .title-gradient, .stat-icon, .tab-bar .nav-link { animation: none !important; transition: none !important; }
        .bg-deco { display: none; }
        .reveal { opacity: 1; transform: none; }
    }

    /* ===== DARK MODE ===== */
    body.dark {
        --surface:#0f172a; --card:#1e293b; --navy2:#1e4080; --border:#334155; --text:#e2e8f0; --muted:#94a3b8;
        background: var(--surface); color: var(--text);
    }
    body.dark .card-panel, body.dark .stat-card, body.dark .stat-mini, body.dark .tab-bar,
    body.dark .form-card, body.dark .sum-stat, body.dark .technician-card, body.dark .card-section { background:#1e293b; border-color:#334155; }
    body.dark .table th { background:#0f172a; }
    body.dark .table tbody tr:hover { background:#16283f; }
    body.dark .technician-header { background:#16283f; }
    body.dark .technician-header:hover { background:#1b2f4b; }
    body.dark .text-dark { color:#e2e8f0 !important; }
    body.dark .text-muted { color:#94a3b8 !important; }
    body.dark .form-control, body.dark .form-select { background:#0f172a; border-color:#334155; color:#e2e8f0; }
    body.dark .bg-white { background:#1e293b !important; }
    body.dark .bg-light { background:#16283f !important; }
    body.dark .alert-secondary { background:#16283f; color:#cbd5e1; border-color:#334155; }
    body.dark .user-item { background:#16283f; border-color:#334155; }
    body.dark .avatar-initial.avatar-navy { background:#1e4080; }
    body.dark .sum-stat .sum-value { color:#e2e8f0; }
    </style>
</head>
<body>

<div class="bg-deco d1"></div>
<div class="bg-deco d2"></div>
<div class="bg-deco d3"></div>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3 mb-4 anim-up">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="#">
            <span class="navbar-brand-logo">BAST</span>
            <span class="fw-bold fs-6 text-white opacity-90">TELKOM AKSES</span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle bg-white bg-opacity-10 d-flex align-items-center justify-content-center"
                     style="width:36px;height:36px;">
                    <i class="bi bi-person-fill text-white"></i>
                </div>
                <div class="lh-1">
                    <div class="text-white fw-semibold" style="font-size:0.85rem;"><%= username %></div>
                    <div class="text-white opacity-60" style="font-size:0.72rem;">Administrator</div>
                </div>
            </div>
            <a href="/admin/report" class="btn btn-sm btn-warning fw-bold rounded-pill px-3 me-1">
    <i class="bi bi-bar-chart-line-fill me-1"></i> Report Migrasi
</a>
<a href="/admin/backup" class="btn btn-sm btn-outline-light fw-bold rounded-pill px-3 me-1"
   title="Unduh backup database">
    <i class="bi bi-database-down me-1"></i> Backup DB
</a>
<button type="button" id="darkToggle" class="btn btn-sm btn-outline-light rounded-pill px-3 me-1" onclick="toggleDark()" title="Mode Gelap/Terang"><i class="bi bi-moon-stars-fill"></i></button>
<a href="/logout" class="btn btn-sm btn-danger fw-bold rounded-pill px-3"
   onclick="return confirm('Yakin ingin logout?')">
    <i class="bi bi-box-arrow-right me-1"></i> Logout
</a>
        </div>
    </div>
</nav>

<div class="container-fluid px-4 mb-5">

    <!-- Blok Statistik -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 anim-up">
            <div class="stat-card blue p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase fw-bold mb-1" style="font-size:0.7rem;color:var(--muted);letter-spacing:.6px;">Total Dokumen BAST</div>
                        <div class="fw-800 mb-0" style="font-size:2rem;font-weight:800;color:#1e293b;line-height:1.1;" data-count="<%= bastData.length %>"><%= bastData.length %></div>
                        <div style="font-size:0.75rem;color:var(--muted);">dokumen terdaftar</div>
                    </div>
                    <div class="stat-icon blue"><i class="bi bi-file-earmark-text-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 anim-up">
            <div class="stat-card green p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase fw-bold mb-1" style="font-size:0.7rem;color:var(--muted);letter-spacing:.6px;">Approved Warehouse</div>
                        <div class="fw-800 mb-0" style="font-size:2rem;font-weight:800;color:#1e293b;line-height:1.1;" data-count="<%= bastData.filter(d => d.status === 'COMPLETED').length %>"><%= bastData.filter(d => d.status === 'COMPLETED').length %></div>
                        <div style="font-size:0.75rem;color:var(--muted);">sudah ditandatangani</div>
                    </div>
                    <div class="stat-icon green"><i class="bi bi-check-circle-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 anim-up">
            <div class="stat-card amber p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase fw-bold mb-1" style="font-size:0.7rem;color:var(--muted);letter-spacing:.6px;">Menunggu Persetujuan</div>
                        <div class="fw-800 mb-0" style="font-size:2rem;font-weight:800;color:#1e293b;line-height:1.1;" data-count="<%= bastData.filter(d => d.status === 'PENDING').length %>"><%= bastData.filter(d => d.status === 'PENDING').length %></div>
                        <div style="font-size:0.75rem;color:var(--muted);">pending di warehouse</div>
                    </div>
                    <div class="stat-icon amber"><i class="bi bi-clock-history"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigasi Tab -->
    <div class="mb-4 anim-up">
        <ul class="nav tab-bar" id="adminTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="rekap-tab" data-bs-toggle="pill" data-bs-target="#rekap-pane" type="button">
                    <i class="bi bi-people-fill me-1"></i> Rekap ONT
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="bast-tab" data-bs-toggle="pill" data-bs-target="#bast-pane" type="button">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Dokumen
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-pane" type="button">
                    <i class="bi bi-shield-lock-fill me-1"></i> Kelola Akun
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link special" id="rekon-tab" data-bs-toggle="pill" data-bs-target="#rekon-pane" type="button">
                    <i class="bi bi-magic me-1"></i> VLOOKUP Rekon
                </button>
            </li>
        </ul>
    </div>

    <!-- TAB CONTENT WRAPPER -->
    <div class="tab-content" id="adminTabContent">
        
        <!-- TAB 1: REKAP ONT + DATA INPUT TEKNISI -->
        <div class="tab-pane fade show active" id="rekap-pane" role="tabpanel">
            <div class="card-panel p-4 mb-4 reveal">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                    <div>
                        <h5 class="fw-bold mb-0 text-navy title-gradient"><i class="bi bi-people-fill me-2"></i> Rekapitulasi ONT per Teknisi</h5>
                        <div class="text-muted" style="font-size:0.8rem;">Rekap BAST lengkap dengan perangkat, kondisi, foto eviden, dan status approval.</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border" style="font-size:0.75rem;"><i class="bi bi-database me-1"></i><span id="saTotalLabel">—</span></span>
                        <a href="/admin/export/excel" class="btn btn-success fw-bold px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-file-earmark-excel-fill me-2"></i> Download Excel (Semua Data)
                        </a>
                    </div>
                </div>

                <!-- Ringkasan Statistik -->
                <div class="row g-2 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="sum-stat d-flex align-items-center gap-3">
                            <div class="sum-icon sum-blue"><i class="bi bi-person-badge-fill"></i></div>
                            <div>
                                <div class="sum-label">Teknisi</div>
                                <div class="sum-value" id="sumTeknisi">—</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="sum-stat d-flex align-items-center gap-3">
                            <div class="sum-icon sum-green"><i class="bi bi-file-earmark-text-fill"></i></div>
                            <div>
                                <div class="sum-label">BAST</div>
                                <div class="sum-value" id="sumBast">—</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="sum-stat d-flex align-items-center gap-3">
                            <div class="sum-icon sum-amber"><i class="bi bi-router-fill"></i></div>
                            <div>
                                <div class="sum-label">ONT</div>
                                <div class="sum-value" id="sumOnt">—</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="sum-stat d-flex align-items-center gap-3">
                            <div class="sum-icon sum-red"><i class="bi bi-images"></i></div>
                            <div>
                                <div class="sum-label">Foto Eviden</div>
                                <div class="sum-value" id="sumFoto">—</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Grafik Tren -->
                <div class="row g-3 mb-4">
                    <div class="col-lg-8">
                        <div class="sum-stat p-3 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold" style="font-size:.9rem;"><i class="bi bi-bar-chart-fill text-danger me-1"></i>Tren Dokumen BAST per Bulan</span>
                                <span class="badge bg-light text-dark border" id="trendTotal">0</span>
                            </div>
                            <div style="position:relative;height:190px;">
                                <canvas id="chartTrend" role="img" aria-label="Bar chart tren BAST per bulan"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="sum-stat p-3 h-100">
                            <div class="fw-bold mb-2" style="font-size:.9rem;"><i class="bi bi-pie-chart-fill text-info me-1"></i>Komposisi Status</div>
                            <div class="d-flex align-items-center gap-3">
                                <div style="position:relative;width:120px;height:120px;flex-shrink:0;">
                                    <canvas id="chartStatus" role="img" aria-label="Donut chart komposisi status"></canvas>
                                </div>
                                <div id="statusLegend" style="font-size:11px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filter Service Area -->
                <div class="d-flex flex-wrap gap-2 mb-3" id="saChips"></div>

                <!-- Search -->
                <div class="mb-3" id="saSearchWrap" style="display:none;">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="saSearch" placeholder="Cari kode BAST, SN, atau No. Internet..." oninput="filterSATable()">
                    </div>
                </div>

                <!-- Filter Tanggal & Export -->
                <div class="row g-2 align-items-center mb-3" id="saDateWrap" style="display:none;">
                    <div class="col-auto">
                        <input type="date" class="form-control form-control-sm" id="saDari" title="Dari tanggal" onchange="filterSATable()">
                    </div>
                    <div class="col-auto">
                        <input type="date" class="form-control form-control-sm" id="saSampai" title="Sampai tanggal" onchange="filterSATable()">
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="resetDateFilter()"><i class="bi bi-x-lg me-1"></i>Reset Tanggal</button>
                    </div>
                    <div class="col-auto ms-auto">
                        <a id="btnExportFilter" href="/admin/export/excel" class="btn btn-sm btn-success fw-bold rounded-pill px-3">
                            <i class="bi bi-file-earmark-excel-fill me-1"></i> Download per Filter
                        </a>
                    </div>
                </div>

                <!-- Konten -->
                <div id="saContent">
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-folder2-open" style="font-size:3rem;opacity:.3;"></i>
                        <div class="mt-2 small">Memuat data rekapitulasi...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: DOKUMEN BAST -->
        <div class="tab-pane fade" id="bast-pane" role="tabpanel">
            <div class="card-panel p-4 mb-4 reveal">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                    <div>
                        <h5 class="fw-bold mb-1 text-danger">
                            <i class="bi bi-file-earmark-arrow-down-fill me-2"></i> Download Dokumen BAST
                        </h5>
                        <p class="text-muted small mb-0">Unduh dokumen PDF yang telah disahkan WH.</p>
                    </div>
                    <div class="input-group" style="max-width:320px;">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="bastSearch" placeholder="Cari kode BAST, STO, teknisi..." oninput="filterBastTable()">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="tabelBast">
                        <thead>
                            <tr>
                                <th>Kode BAST</th>
                                <th>Tanggal</th>
                                <th>STO</th>
                                <th>Teknisi</th>
                                <th>Warehouse</th>
                                <th>Status</th>
                                <th class="text-center">Aksi Unduh</th>
                            </tr>
                        </thead>
                        <tbody id="bastTbody">
                            <% bastData.forEach(d => { %>
                            <tr data-tanggal="<%= d.tanggal %>" data-status="<%= d.status %>">
                                <td class="fw-bold font-monospace text-danger"><%= d.kode_unik %></td>
                                <td><%= d.tanggal %></td>
                                <td><%= d.loksto %></td>
                                <td><%= d.teknisi_nama %></td>
                                <td><%= d.wh_nama || '-' %></td>
                                <td>
                                    <% if(d.status === 'COMPLETED') { %>
                                        <span class="badge-completed">Approved (WH)</span>
                                    <% } else if(d.status === 'REJECTED') { %>
                                        <span class="badge-rejected">Ditolak WH</span>
                                    <% } else { %>
                                        <span class="badge-pending">Pending WH</span>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <% if(d.status === 'COMPLETED') { %>
                                        <a href="/bast/cetak/<%= d.kode_unik %>" target="_blank"
                                            class="btn btn-sm btn-danger rounded-pill px-3 fw-medium shadow-sm">
                                            <i class="bi bi-printer-fill me-1"></i> Buka & Cetak PDF
                                        </a>
                                    <% } else { %>
                                        <span class="text-muted small">Belum Disetujui WH</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    <div class="d-flex justify-content-between align-items-center mt-3" id="bastPaginationWrap" style="display:none;">
                        <span class="text-muted small" id="bastInfo">-</span>
                        <div class="d-flex flex-wrap gap-1" id="bastPagination"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: KELOLA AKUN TERINTEGRASI -->
        <div class="tab-pane fade" id="users-pane" role="tabpanel">
            <div class="row g-4 mb-4">
                <!-- FORM BUAT AKUN -->
                <div class="col-lg-5">
                    <div class="form-card h-100">
                        <div class="card-header-custom">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-person-plus-fill fs-5"></i>
                                    <div>
                                        <div class="fw-700" style="font-weight:700;">Buat Akun Baru</div>
                                        <div class="opacity-70" style="font-size:0.75rem;">Teknisi otomatis terdaftar ke form input</div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-warning fw-bold rounded-pill px-3" onclick="bukaImportAkun()">
                                    <i class="bi bi-file-earmark-spreadsheet-fill me-1"></i> Buat Banyak (Import)
                                </button>
                            </div>
                        </div>
                        <div class="p-4">
                            <div class="mb-4">
                                <label class="form-label fw-semibold small mb-2">Pilih Role <span class="text-danger">*</span></label>
                                <div class="role-toggle">
                                    <input type="radio" name="roleToggle" id="roleTeknisi" value="teknisi" checked onchange="toggleRoleFields()">
                                    <label for="roleTeknisi">
                                        <i class="bi bi-tools"></i>
                                        Teknisi
                                    </label>
                                    <input type="radio" name="roleToggle" id="roleWH" value="wh" onchange="toggleRoleFields()">
                                    <label for="roleWH">
                                        <i class="bi bi-box-seam"></i>
                                        Warehouse
                                    </label>
                                </div>
                            </div>

                            <form action="/admin/user/add" method="POST" id="formAkun">
                                <input type="hidden" name="role" id="hiddenRole" value="teknisi">

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">NIK <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="nik" placeholder="Contoh: 26050119" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Nama Lengkap <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="nama_lengkap" id="fieldNama" placeholder="Contoh: ANDI ARYA WIJAYA" required>
                                    <div class="form-text text-success fw-semibold" id="namaHint">
                                        Nama ini akan otomatis masuk ke dropdown Teknisi form BAST.
                                    </div>
                                </div>

                                <!-- FIELD SERVICE AREA BARU -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Service Area <span class="text-danger">*</span></label>
                                    <select class="form-select" name="service_area" required>
                                        <option value="" disabled selected>— Pilih Service Area —</option>
                                        <option value="CINERE">CINERE</option>
                                        <option value="DEPOK & RAWAGENI">DEPOK &amp; RAWAGENI</option>
                                        <option value="KALIABANG">KALIABANG</option>
                                        <option value="KRANJI">KRANJI</option>
                                        <option value="PEKAYON">PEKAYON</option>
                                        <option value="PONDOKGEDE">PONDOKGEDE</option>
                                        <option value="SUKMAJAYA">SUKMAJAYA</option>
                                        <option value="BEKASI">BEKASI</option>
                                    </select>
                                    <div class="form-text text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        Pilih wilayah layanan teknisi/WH (CINERE s.d. BEKASI).
                                    </div>
                                </div>

                                <!-- FIELD LOKASI STO BARU -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Lokasi STO <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control text-uppercase" name="sto" 
                                           placeholder="Contoh: SKJ / CMG / DPK / BJD" 
                                           required autocomplete="off"
                                           style="font-family: monospace; font-weight: 600; letter-spacing: 1px;">
                                    <div class="form-text text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Ketik kode STO: <b>SKJ</b> (Sukmajaya), <b>CMG</b> (Cimanggis), <b>DPK</b> (Depok), 
                                        <b>CBN</b> (Cibinong), <b>CSL</b> (Cileungsi), <b>BGR</b> (Bogor), 
                                        <b>BJD</b> (Bojong Depok), <b>BKS</b> (Bekasi), <b>ALL</b> (Semua STO)
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">
                                        Username Login
                                    </label>
                                    <input type="text" class="form-control bg-light" name="username" id="fieldUsername"
                                           placeholder="Otomatis dari NIK" readonly
                                           style="font-family:monospace;color:var(--muted);">
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold small">Password <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" name="password" placeholder="Password akun" required>
                                </div>

                                <button type="submit" class="btn-navy w-100 py-2">
                                    <i class="bi bi-person-check-fill me-2"></i> Buat Akun & Tambahkan
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- DAFTAR AKUN -->
                <div class="col-lg-7">
                    <div class="form-card h-100">
                        <div class="card-header-custom">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-people-fill fs-5"></i>
                                    <div>
                                        <div class="fw-700" style="font-weight:700;">Daftar Akun Aktif</div>
                                        <div class="opacity-70" style="font-size:0.75rem;">Master Data Teknisi &amp; Warehouse</div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-light text-dark border" style="font-size:0.72rem;">
                                        <i class="bi bi-tools me-1"></i> <%= teknisiList.length %>
                                    </span>
                                    <span class="badge bg-light text-dark border" style="font-size:0.72rem;">
                                        <i class="bi bi-box-seam me-1"></i> <%= (whList || []).length %>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="p-4" style="overflow-y:auto;max-height:680px;">
                            <!-- TEKNISI LIST -->
                            <div class="section-label"><i class="bi bi-tools me-1"></i> Akun Teknisi (Tampil di Dropdown)</div>
                            <% if (teknisiList.length === 0) { %>
                                <div class="text-center text-muted py-3 small">Belum ada akun teknisi</div>
                            <% } %>
                            <% teknisiList.forEach(u => { %>
                            <div class="user-item">
                                <div class="avatar-initial avatar-navy">
                                    <%= (u.nama_lengkap || u.username).charAt(0).toUpperCase() %>
                                </div>
                                <div class="user-meta">
                                    <div class="username"><%= u.nama_lengkap || u.username %> <span class="sto-badge"><%= u.sto || 'ALL' %></span></div>
                                    <div class="nik">NIK: <%= u.nik || u.username %> <% if (u.service_area) { %><span class="sa-badge"><i class="bi bi-geo-alt-fill"></i><%= u.service_area %></span><% } %></div>
                                </div>
                                <span class="badge-role-teknisi">Teknisi</span>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openEditAkun('<%= u.id %>', '<%= u.nama_lengkap %>', '<%= u.sto %>', '<%= u.service_area %>')"><i class="bi bi-pencil me-1"></i>Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3" onclick="openResetPw('<%= u.id %>', '<%= u.username %>')"><i class="bi bi-key me-1"></i>Reset PW</button>
                                <a href="/admin/user/delete/<%= u.id %>" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Hapus akun <%= u.username %>?')">Hapus</a>
                            </div>
                            <% }) %>

                            <!-- WH LIST -->
                            <div class="section-label mt-4"><i class="bi bi-box-seam me-1"></i> Akun Warehouse</div>
                            <% if ((whList || []).length === 0) { %>
                                <div class="text-center text-muted py-3 small">Belum ada akun warehouse</div>
                            <% } %>
                            <% (whList || []).forEach(u => { %>
                            <div class="user-item">
                                <div class="avatar-initial avatar-red">
                                    <%= (u.nama_lengkap || u.username).charAt(0).toUpperCase() %>
                                </div>
                                <div class="user-meta">
                                    <div class="username"><%= u.nama_lengkap || u.username %> <span class="sto-badge"><%= u.sto || 'ALL' %></span></div>
                                    <div class="nik">NIK: <%= u.nik || u.username %> <% if (u.service_area) { %><span class="sa-badge"><i class="bi bi-geo-alt-fill"></i><%= u.service_area %></span><% } %></div>
                                </div>
                                <span class="badge-role-wh">Warehouse</span>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openEditAkun('<%= u.id %>', '<%= u.nama_lengkap %>', '<%= u.sto %>', '<%= u.service_area %>')"><i class="bi bi-pencil me-1"></i>Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3" onclick="openResetPw('<%= u.id %>', '<%= u.username %>')"><i class="bi bi-key me-1"></i>Reset PW</button>
                                <a href="/admin/user/delete/<%= u.id %>" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Hapus akun WH <%= u.username %>?')">Hapus</a>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 5: VLOOKUP REKON -->
        <div class="tab-pane fade" id="rekon-pane" role="tabpanel">
            <div class="card-panel p-4 mb-4 reveal">
                <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-file-earmark-spreadsheet-fill me-2"></i> Rekonsiliasi Data Aktual vs Database BAST</h5>
                <p class="text-muted small">Blok (Ctrl+A / Ctrl+C) seluruh data Excel Anda beserta headernya, lalu paste (Ctrl+V) ke dalam kotak di bawah ini.</p>

                <textarea id="excelPasteArea" class="form-control mb-3 font-monospace" rows="5" placeholder="Paste data Excel dari kolom witel sampai valid_bayar di sini..."></textarea>

                <div class="d-flex gap-2">
                    <button type="button" onclick="prosesRekon()" class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-gear-fill me-2"></i> Proses Komparasi (VLOOKUP)
                    </button>
                    <button type="button" onclick="document.getElementById('modalContoh').style.display='flex'" class="btn btn-outline-secondary fw-bold px-4 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-eye-fill me-2"></i> Lihat Contoh Template
                    </button>
                </div>
            </div>

            <!-- Hasil Rekon -->
            <div id="resultArea" class="card-panel p-4 mb-4 reveal" style="display:none;">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <h5 class="fw-bold text-success mb-0"><i class="bi bi-check2-all me-2"></i> Hasil Komparasi Berhasil!</h5>
                    <div class="d-flex gap-2">
                        <button type="button" onclick="toggleReport()" class="btn btn-info text-white fw-bold px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-bar-chart-line-fill me-1"></i> Lihat Report Progres
                        </button>
                        <button type="button" onclick="downloadExcel()" class="btn btn-success fw-bold px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-file-earmark-excel-fill me-1"></i> Download Excel Output
                        </button>
                    </div>
                </div>

                <div id="reportArea" class="mb-4 p-4 border rounded-4 bg-light shadow-sm" style="display:none;">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-pie-chart-fill me-2 text-info"></i> Ringkasan Progres & Pencapaian</h6>
                    <div class="row g-3 text-center mb-4">
                        <div class="col-md-3">
                            <div class="bg-white border rounded-3 p-3 shadow-sm">
                                <span class="text-muted small fw-bold">TOTAL DATA EXCEL</span>
                                <h3 id="totData" class="fw-bold text-dark mb-0 mt-1">0</h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="bg-success-subtle border-success rounded-3 p-3 shadow-sm border">
                                <span class="text-success small fw-bold">TOTAL DONE RETURN</span>
                                <h3 id="totDone" class="fw-bold text-success mb-0 mt-1">0</h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="bg-warning-subtle border-warning rounded-3 p-3 shadow-sm border">
                                <span class="text-warning-emphasis small fw-bold">TOTAL PENDING WH</span>
                                <h3 id="totPending" class="fw-bold text-warning-emphasis mb-0 mt-1">0</h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="bg-danger-subtle border-danger rounded-3 p-3 shadow-sm border">
                                <span class="text-danger small fw-bold">TOTAL NOK / KENDALA</span>
                                <h3 id="totNok" class="fw-bold text-danger mb-0 mt-1">0</h3>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white p-3 rounded-3 border shadow-sm mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-secondary small">Persentase Pencapaian (DONE)</span>
                            <span id="progressText" class="fw-bold text-success fs-5">0%</span>
                        </div>
                        <div class="progress" style="height:24px;border-radius:12px;">
                            <div id="progressBar" class="progress-bar bg-success progress-bar-striped progress-bar-animated fw-bold" role="progressbar" style="width:0%;">0%</div>
                        </div>
                    </div>
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-table me-2 text-primary"></i> Tabel Pivot Progres Berdasarkan Status</h6>
                    <div class="table-responsive border rounded bg-white shadow-sm">
                        <table class="table table-bordered table-sm text-center align-middle mb-0" style="font-size:0.85rem;">
                            <thead style="background-color:#0e294b;color:white;">
