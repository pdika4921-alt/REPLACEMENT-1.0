    <%- JSON.stringify(bastData.map(d => ({ status: d.status }))) %>
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Sinkronisasi NIK → username (readonly)
    document.querySelector('input[name="nik"]').addEventListener('input', function() {
        document.getElementById('fieldUsername').value = this.value;
    });

    // Toggle role hidden field
    function toggleRoleFields() {
        const selectedRole = document.querySelector('input[name="roleToggle"]:checked').value;
        document.getElementById('hiddenRole').value = selectedRole;
        const hint = document.getElementById('namaHint');
        if (selectedRole === 'wh') {
            hint.textContent = 'Nama ini otomatis tercetak di dokumen BAST sebagai pihak penerima WH.';
            hint.className = 'form-text text-danger fw-semibold';
        } else {
            hint.textContent = 'Nama ini akan otomatis masuk ke dropdown Teknisi form BAST.';
            hint.className = 'form-text text-success fw-semibold';
        }
    }

    // Reset password akun (admin)
    let resetPwTargetId = null;
    function openResetPw(id, username) {
        resetPwTargetId = id;
        document.getElementById('resetPwUser').innerText = username + ' (id: ' + id + ')';
        document.getElementById('resetPwNew').value = '';
        document.getElementById('resetPwAlert').className = 'alert d-none small mb-3';
        new bootstrap.Modal(document.getElementById('modalResetPw')).show();
    }
    function simpanResetPw() {
        const np = document.getElementById('resetPwNew').value;
        const alertEl = document.getElementById('resetPwAlert');
        const btn = document.getElementById('btnResetPw');
        if (!np || np.length < 4) {
            alertEl.className = 'alert alert-danger small mb-3';
            alertEl.textContent = 'Password minimal 4 karakter.';
            return;
        }
        btn.disabled = true;
        fetch('/admin/user/reset', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: resetPwTargetId, new_password: np })
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                alertEl.className = 'alert alert-success small mb-3';
                alertEl.textContent = d.message;
                setTimeout(() => bootstrap.Modal.getInstance(document.getElementById('modalResetPw')).hide(), 1200);
            } else {
                alertEl.className = 'alert alert-danger small mb-3';
                alertEl.textContent = d.message;
            }
        })
        .catch(() => { alertEl.className = 'alert alert-danger small mb-3'; alertEl.textContent = 'Kendala koneksi ke server.'; })
        .finally(() => { btn.disabled = false; });
    }

    // Edit akun (nama, STO, service area)
    let editAkunId = null;
    function openEditAkun(id, nama, sto, sa) {
        editAkunId = id;
        document.getElementById('editNama').value = (nama || '');
        document.getElementById('editSto').value = (sto || '');
        document.getElementById('editSa').value = (sa || '');
        document.getElementById('editAkunAlert').className = 'alert d-none small mb-3';
        new bootstrap.Modal(document.getElementById('modalEditAkun')).show();
    }
    function simpanEditAkun() {
        const alertEl = document.getElementById('editAkunAlert');
        const btn = document.getElementById('btnEditAkun');
        btn.disabled = true;
        fetch('/admin/user/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                id: editAkunId,
                nama_lengkap: document.getElementById('editNama').value,
                sto: document.getElementById('editSto').value,
                service_area: document.getElementById('editSa').value
            })
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                alertEl.className = 'alert alert-success small mb-3';
                alertEl.textContent = d.message;
                setTimeout(() => { bootstrap.Modal.getInstance(document.getElementById('modalEditAkun')).hide(); window.location.reload(); }, 900);
            } else {
                alertEl.className = 'alert alert-danger small mb-3';
                alertEl.textContent = d.message;
            }
        })
        .catch(() => { alertEl.className = 'alert alert-danger small mb-3'; alertEl.textContent = 'Kendala koneksi ke server.'; })
        .finally(() => { btn.disabled = false; });
    }

    // ===== Search + filter daftar akun =====
    function filterAkunList() {
        const kw = (document.getElementById('akunSearch').value || '').toLowerCase().trim();
        const items = document.querySelectorAll('.user-item');
        let visibleCount = 0;
        items.forEach(item => {
            const match = !kw || item.textContent.toLowerCase().includes(kw);
            item.style.display = match ? '' : 'none';
            if (match) visibleCount++;
        });
        const sections = document.querySelectorAll('.section-label');
        sections.forEach(sec => {
            let anyVisible = false;
            let next = sec.nextElementSibling;
            while (next && !next.classList.contains('section-label')) {
                if (next.classList.contains('user-item') && next.style.display !== 'none') anyVisible = true;
                next = next.nextElementSibling;
            }
            sec.style.display = anyVisible ? '' : 'none';
        });
        document.getElementById('akunKosong').style.display = visibleCount === 0 ? '' : 'none';
    }

    // ===== Pilih massal & hapus massal akun =====
    function updateAkunTerpilih() {
        const checks = document.querySelectorAll('.akunCheck:checked');
        document.getElementById('akunTerpilihCount').textContent = checks.length;
        document.getElementById('btnHapusTerpilih').disabled = checks.length === 0;
    }
    function hapusAkunTerpilih() {
        const checks = document.querySelectorAll('.akunCheck:checked');
        if (checks.length === 0) return;
        if (!confirm('Yakin ingin menghapus ' + checks.length + ' akun terpilih?')) return;
        const ids = Array.from(checks).map(c => c.value);
        const btn = document.getElementById('btnHapusTerpilih');
        btn.disabled = true;
        fetch('/admin/user/bulk-delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids })
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                alert(d.message);
                window.location.reload();
            } else {
                alert(d.message || 'Gagal menghapus akun.');
                updateAkunTerpilih();
            }
        })
        .catch(() => { alert('Kendala koneksi ke server.'); updateAkunTerpilih(); });
    }

    const SERVICE_AREAS_BULK = ['CINERE','DEPOK & RAWAGENI','KALIABANG','KRANJI','PEKAYON','PONDOKGEDE','SUKMAJAYA','BEKASI'];
    function setBulkRole() {
        const role = document.getElementById('bulkRole').value;
        const label = document.getElementById('bulkRoleLabel');
        if (label) label.innerHTML = role === 'wh'
            ? '<i class="bi bi-box-seam me-1"></i>Akan dibuat sebagai: <b>Warehouse (WH)</b>'
            : '<i class="bi bi-tools me-1"></i>Akan dibuat sebagai: <b>Teknisi</b>';
    }
    function bulkSaOptions(selected) {
        let opt = '<option value="">- Semua -</option>';
        SERVICE_AREAS_BULK.forEach(sa => {
            const isSel = (selected && String(selected).toUpperCase().trim() === sa) ? ' selected' : '';
            opt += `<option${isSel}>${sa}</option>`;
        });
        return opt;
    }
    // Format Excel: NIK[tab]Nama[tab]Service Area[tab]STO
    function addBulkRow(nik, nama, sa, sto) {
        const tbody = document.getElementById('bulkRows');
        if (!tbody) return;
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td style="min-width:130px;"><input type="text" class="form-control form-control-sm bulkNik" placeholder="NIK / Username" value="${escAttr(nik||'')}"></td>
            <td style="min-width:180px;"><input type="text" class="form-control form-control-sm bulkNama" placeholder="Nama lengkap" value="${escAttr(nama||'')}"></td>
            <td style="min-width:150px;"><select class="form-select form-select-sm bulkSa">${bulkSaOptions(sa)}</select></td>
            <td style="min-width:90px;"><input type="text" class="form-control form-control-sm text-uppercase bulkSto" placeholder="SKJ" value="${escAttr(sto||'')}"></td>
            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" onclick="hapusBulkRow(this)"><i class="bi bi-x-lg"></i></button></td>`;
        tbody.appendChild(tr);
        const nikInput = tr.querySelector('.bulkNik');
        if (nikInput) {
            nikInput.addEventListener('input', function () { this.value = this.value.toUpperCase(); });
        }
    }
    function hapusBulkRow(btn) { btn.closest('tr').remove(); }
    
    const HEADER_KEYWORDS = ['nik','nama','service','area','sto','role','username'];
    function prosesBulkPaste() {
        const textEl = document.getElementById('bulkPasteArea');
        if (!textEl) return;
        const text = textEl.value;
        if(!text || !text.trim()) return alert("Paste area masih kosong!");
        
        const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
        const tbody = document.getElementById('bulkRows');
        let count = 0;

        lines.forEach((line, i) => {
            let cols;
            if (line.indexOf('\t') !== -1) cols = line.split('\t');
            else if (line.indexOf(',') !== -1) cols = line.split(',');
            else if (line.indexOf(';') !== -1) cols = line.split(';');
            else cols = line.split(/[ ]{2,}/);
            
            cols = cols.map(c => c.trim());
            const flat = cols.join(' ').toLowerCase();

            if (i === 0 && HEADER_KEYWORDS.some(k => flat.includes(k))) return;
            if (cols.length < 1) return;

            count++;
            // NIK = cols[0], Nama = cols[1], Service Area = cols[2], STO = cols[3]
            addBulkRow(cols[0], cols[1] || '', cols[2] || '', cols[3] || '');
        });
        
        textEl.value = '';
        if (count > 0) alert(count + " baris berhasil diproses.");
        else alert("Tidak ada data valid terdeteksi. Gunakan Tab/Koma sebagai pemisah.");
    }

    function toggleBulkPanel() {
        const panel = document.getElementById('bulkPanel');
        if (!panel) return;
        if (panel.style.display === 'none') {
            document.getElementById('bulkRows').innerHTML = '';
            document.getElementById('bulkPasteArea').value = '';
            document.getElementById('bulkAddAlert').className = 'alert d-none small mb-3';
            setBulkRole();
            addBulkRow();
            panel.style.display = 'block';
            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
            panel.style.display = 'none';
        }
    }
    function simpanBulkAdd() {
        const rows = document.querySelectorAll('#bulkRows tr');
        const role = document.getElementById('bulkRole').value || 'teknisi';
        const users = [];
        rows.forEach(tr => {
            const nik = tr.querySelector('.bulkNik').value.trim();
            const nama = tr.querySelector('.bulkNama').value.trim();
            const sto = tr.querySelector('.bulkSto').value.trim().toUpperCase();
            const sa = tr.querySelector('.bulkSa').value;
            if (!nik) return;
            users.push({ role, nik, nama_lengkap: nama, password: '', sto, service_area: sa });
        });
        if (users.length === 0) {
            const alertEl = document.getElementById('bulkAddAlert');
            alertEl.className = 'alert alert-warning small mb-3';
            alertEl.textContent = 'Tidak ada baris yang terisi NIK.';
            return;
        }
        const btn = document.getElementById('btnBulkAdd');
        const alertEl = document.getElementById('bulkAddAlert');
        btn.disabled = true;
        alertEl.className = 'alert alert-info small mb-3';
        alertEl.textContent = 'Menyimpan ' + users.length + ' akun sebagai ' + (role === 'wh' ? 'Warehouse' : 'Teknisi') + '...';
        fetch('/admin/user/bulk-add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ users })
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                alertEl.className = 'alert alert-success small mb-3';
                alertEl.textContent = d.message;
                setTimeout(() => { document.getElementById('bulkPanel').style.display = 'none'; window.location.reload(); }, 1200);
            } else {
                alertEl.className = 'alert alert-danger small mb-3';
                alertEl.textContent = d.message || 'Gagal menyimpan akun.';
            }
        })
        .catch(() => { alertEl.className = 'alert alert-danger small mb-3'; alertEl.textContent = 'Kendala koneksi ke server.'; })
        .finally(() => { btn.disabled = false; });
    }

    // ===== Hapus dokumen BAST (admin) =====
    function hapusBast(kode) {
        if (!confirm('Yakin ingin menghapus dokumen BAST ' + kode + '? Data tidak dapat dikembalikan.')) return;
        fetch('/admin/bast/delete/' + encodeURIComponent(kode), { method: 'POST' })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    alert(d.message);
                    window.location.reload();
                } else {
                    alert(d.message || 'Gagal menghapus dokumen.');
                }
            })
            .catch(() => { alert('Kendala koneksi ke server.'); });
    }

    // ===== Search + Pagination tabel Dokumen BAST =====
    const BAST_PAGE_SIZE = 10;
    let bastRows = [];
    function tandaiAged() {
        document.querySelectorAll('#bastTbody tr[data-status="PENDING"]').forEach(function (tr) {
            const tgl = tr.getAttribute('data-tanggal');
            if (!tgl) return;
            const days = Math.floor((Date.now() - new Date(tgl + 'T00:00:00').getTime()) / 86400000);
            if (isNaN(days) || days <= 7) return;
            const st = tr.querySelector('td:nth-child(6)');
            if (st) st.innerHTML += ' <span class="badge bg-danger ms-1" style="font-size:.62rem;">&gt;7 hari</span>';
        });
    }
    function initBastTable() {
        const tbody = document.getElementById('bastTbody');
        if (!tbody) return;
        bastRows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
        tandaiAged();
        renderBastTable();
    }
    function filterBastTable() {
        const kw = (document.getElementById('bastSearch').value || '').toLowerCase().trim();
        bastRows.forEach(function (tr) {
            tr.style.display = (kw && !tr.textContent.toLowerCase().includes(kw)) ? 'none' : '';
        });
        renderBastTable();
    }
    function renderBastTable() {
        const kw = (document.getElementById('bastSearch').value || '').toLowerCase().trim();
        const visible = bastRows.filter(function (tr) {
            return !kw || tr.textContent.toLowerCase().includes(kw);
        });
        const wrap = document.getElementById('bastPaginationWrap');
        const info = document.getElementById('bastInfo');
        const pager = document.getElementById('bastPagination');
        if (!wrap) return;
        if (visible.length <= BAST_PAGE_SIZE) {
            wrap.style.display = 'none';
            bastRows.forEach(function (tr) { tr.style.display = (kw && !tr.textContent.toLowerCase().includes(kw)) ? 'none' : ''; });
            return;
        }
        wrap.style.display = 'flex';
        info.textContent = visible.length + ' dokumen ditemukan';
        const pages = Math.ceil(visible.length / BAST_PAGE_SIZE);
        pager.innerHTML = '';
        for (let p = 1; p <= pages; p++) {
            (function (pg) {
                const b = document.createElement('button');
                b.type = 'button';
                b.className = 'btn btn-sm rounded-pill ' + (pg === 1 ? 'btn-dark' : 'btn-light border');
                b.textContent = pg;
                b.style.margin = '0 2px';
                b.onclick = function () {
                    bastRows.forEach(function (tr) { tr.style.display = 'none'; });
                    visible.slice((pg - 1) * BAST_PAGE_SIZE, pg * BAST_PAGE_SIZE).forEach(function (tr) { tr.style.display = ''; });
                    Array.prototype.forEach.call(pager.children, function (x) {
                        x.className = 'btn btn-sm rounded-pill ' + (parseInt(x.textContent, 10) === pg ? 'btn-dark' : 'btn-light border');
                    });
                };
                pager.appendChild(b);
            })(p);
        }
        bastRows.forEach(function (tr) { tr.style.display = 'none'; });
        visible.slice(0, BAST_PAGE_SIZE).forEach(function (tr) { tr.style.display = ''; });
    }
    initBastTable();

    // ===== Grafik tren & komposisi status =====
    let chartTrendInst = null, chartStatusInst = null;
    function initCharts() {
        if (!window.Chart) return;
        let dates = [];
        try { dates = JSON.parse(document.getElementById('trendServer').textContent) || []; } catch (e) {}
        const byMonth = {};
        dates.forEach(function (d) {
            const m = String(d || '').slice(0, 7);
            if (m) byMonth[m] = (byMonth[m] || 0) + 1;
        });
        const labels = Object.keys(byMonth).sort();
        const values = labels.map(function (l) { return byMonth[l]; });
        document.getElementById('trendTotal').textContent = dates.length + ' dokumen';

        if (chartTrendInst) chartTrendInst.destroy();
        chartTrendInst = new Chart(document.getElementById('chartTrend'), {
            type: 'bar',
            data: {
                labels: labels.length ? labels : ['—'],
                datasets: [{ label: 'BAST', data: labels.length ? values : [0], backgroundColor: '#EE2E24', borderRadius: 6, maxBarThickness: 34 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10 } } },
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { color: '#64748b', font: { size: 10 }, stepSize: 1 } }
                }
            }
        });

        const st = { COMPLETED: 0, PENDING: 0, REJECTED: 0 };
        try {
            const bast = JSON.parse(document.getElementById('trendBastServer').textContent) || [];
            bast.forEach(function (b) { if (st[b.status] !== undefined) st[b.status]++; });
        } catch (e) {}
        const donutData = [
            { label: 'Approved', val: st.COMPLETED, color: '#22c55e' },
            { label: 'Pending',  val: st.PENDING,   color: '#f59e0b' },
            { label: 'Ditolak',  val: st.REJECTED,  color: '#EE2E24' }
        ].filter(function (d) { return d.val > 0; });

        if (chartStatusInst) chartStatusInst.destroy();
        chartStatusInst = new Chart(document.getElementById('chartStatus'), {
            type: 'doughnut',
            data: {
                labels: donutData.map(function (d) { return d.label; }),
                datasets: [{ data: donutData.map(function (d) { return d.val; }), backgroundColor: donutData.map(function (d) { return d.color; }), borderWidth: 2, borderColor: '#fff' }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '62%', plugins: { legend: { display: false } } }
        });
        document.getElementById('statusLegend').innerHTML = donutData.map(function (d) {
            return '<div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;"><span style="width:10px;height:10px;border-radius:3px;background:' + d.color + ';flex-shrink:0;"></span><span style="color:#64748b">' + d.label + '</span><span style="font-weight:700;margin-left:auto;padding-left:8px;">' + d.val + '</span></div>';
        }).join('') || '<div class="text-muted small">Belum ada data.</div>';
    }
initCharts();

    // ═════════════════════════════════════════════════════════════════
    // DATA INPUT TEKNISI — filter per Service Area
    // ═════════════════════════════════════════════════════════════════
    // DATA INPUT TEKNISI — filter per Service Area
    // ═════════════════════════════════════════════════════════════════
    const SERVICE_AREAS = ['CINERE','DEPOK & RAWAGENI','KALIABANG','KRANJI','PEKAYON','PONDOKGEDE','SUKMAJAYA','BEKASI'];
    let saCounts = {};
    let saCache  = {};
    let saActive = null;

    function muatSAMeta() {
        fetch('/admin/data-teknisi/meta')
            .then(r => r.json())
            .then(data => {
                saCounts = data.counts || {};
                document.getElementById('saTotalLabel').textContent = 'Total: ' + (data.total || 0) + ' BAST';
                renderSAChips();
                if (!saActive) {
                    const firstSA = SERVICE_AREAS.find(sa => (saCounts[sa] || 0) > 0) || SERVICE_AREAS[0];
                    if (firstSA) pilihSA(firstSA);
                }
            })
            .catch(() => { document.getElementById('saTotalLabel').textContent = 'Gagal memuat jumlah.'; });
    }

    function renderSAChips() {
        const wrap = document.getElementById('saChips');
        wrap.innerHTML = '';
        SERVICE_AREAS.forEach(sa => {
            const n = saCounts[sa] || 0;
            const active = (sa === saActive);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-sm fw-semibold rounded-pill px-3 shadow-sm border';
            btn.style.cssText = active
                ? 'background:var(--navy);color:#fff;border-color:var(--navy);'
                : 'background:#fff;color:#1e293b;border-color:#e2e8f0;';
            btn.innerHTML = '<i class="bi bi-geo-alt-fill me-1"></i>' + sa +
                ' <span class="badge ' + (active ? 'bg-white text-navy' : 'bg-light text-muted') + ' ms-1">' + n + '</span>';
            btn.onclick = () => pilihSA(sa);
            wrap.appendChild(btn);
        });
    }

    function pilihSA(sa) {
        saActive = sa;
        renderSAChips();
        document.getElementById('saSearchWrap').style.display = 'block';
        document.getElementById('saDateWrap').style.display = 'flex';
        document.getElementById('saSearch').value = '';
        document.getElementById('saDari').value = '';
        document.getElementById('saSampai').value = '';
        document.getElementById('btnExportFilter').href = '/admin/export/excel?sa=' + encodeURIComponent(sa);
        const content = document.getElementById('saContent');
        if (saCache[sa]) { renderSATeknisi(saCache[sa]); return; }
        content.innerHTML = '<div class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm text-navy" role="status"></div><div class="small mt-2">Memuat data ' + sa + '...</div></div>';
        fetch('/admin/data-teknisi?sa=' + encodeURIComponent(sa))
            .then(r => r.json())
            .then(data => {
                saCache[sa] = data;
                renderSATeknisi(data);
            })
            .catch(() => { content.innerHTML = '<div class="alert alert-danger mb-0">Gagal memuat data.</div>'; });
    }

    function resetDateFilter() {
        document.getElementById('saDari').value = '';
        document.getElementById('saSampai').value = '';
        filterSATable();
    }

    function updateSummary(data) {
        let ont = 0, foto = 0;
        (data.teknisi || []).forEach(t => { ont += (t.total_ont || 0); foto += (t.total_foto || 0); });
        if (window.setCount) {
            setCount('sumTeknisi', (data.teknisi || []).length);
            setCount('sumBast', data.total_bast || 0);
            setCount('sumOnt', ont);
            setCount('sumFoto', foto);
        } else {
            document.getElementById('sumTeknisi').textContent = (data.teknisi || []).length;
            document.getElementById('sumBast').textContent = data.total_bast || 0;
            document.getElementById('sumOnt').textContent = ont;
            document.getElementById('sumFoto').textContent = foto;
        }
    }

    function renderSATeknisi(data) {
        const content = document.getElementById('saContent');
        if (!data || !data.success) {
            updateSummary({ teknisi: [], total_bast: 0 });
            content.innerHTML = '<div class="alert alert-danger mb-0">' + (data && data.message || 'Terjadi kesalahan.') + '</div>';
            return;
        }
        updateSummary(data);
        if (data.teknisi.length === 0) {
            content.innerHTML = '<div class="alert alert-secondary text-center mb-0 rounded-4 border-0">Belum ada input BAST dari teknisi di <b>' + escHtml(data.sa) + '</b>.</div>';
            return;
        }
        let html = '<div class="mb-3 small text-muted"><i class="bi bi-check2-circle text-success me-1"></i>' + data.total_bast +
                   ' BAST dari ' + data.teknisi.length + ' teknisi di <b>' + escHtml(data.sa) + '</b></div>';
        data.teknisi.forEach((t, idx) => {
            html += `
              <div class="technician-card mb-2">
                <div class="technician-header" onclick="toggleTeknisi(${idx})">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-initial avatar-navy">${escHtml((t.nama || '?').charAt(0).toUpperCase())}</div>
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-bold text-dark" style="font-size:1rem;">${escHtml(t.nama)}</span>
                                <span class="tech-badge sto"><i class="bi bi-geo-alt-fill me-1"></i>${escHtml(t.sto || '-')}</span>
                                <span class="tech-badge sa"><i class="bi bi-globe2 me-1"></i>${escHtml(data.sa)}</span>
                            </div>
                            <div class="text-muted small font-monospace mt-1">NIK: ${escHtml(t.nik)}</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge" style="background:var(--navy);color:#fff;">${t.total_bast} BAST</span>
                        <span class="badge bg-light text-primary border">${t.total_ont} ONT</span>
                        <span class="badge bg-light text-muted border">${t.total_foto} Foto</span>
                        <i class="bi bi-chevron-down text-muted fs-6" id="chevTek${idx}"></i>
                    </div>
                </div>
                <div class="collapse" id="tekBody${idx}">
                    <div class="p-3 bg-white">
                        ${t.records.length === 0 ? '<div class="text-muted small">Tidak ada BAST.</div>' : t.records.map(renderBAST).join('')}
                    </div>
                </div>
              </div>`;
        });
        content.innerHTML = html;
    }

    function toggleTeknisi(idx) {
        const el = document.getElementById('tekBody' + idx);
        const chev = document.getElementById('chevTek' + idx);
        if (!el) return;
        if (el.classList.contains('show')) { bootstrap.Collapse.getInstance(el) ? bootstrap.Collapse.getInstance(el).hide() : new bootstrap.Collapse(el).hide(); if (chev) chev.classList.remove('bi-chevron-up'); }
        else { new bootstrap.Collapse(el, { toggle: false }).show(); if (chev) chev.classList.replace('bi-chevron-down','bi-chevron-up'); }
    }

    function kondisiBadge(k) {
        const s = String(k || '').toUpperCase();
        const cls = s.includes('BAIK') ? 'bg-success-subtle text-success'
            : (s.includes('RUSAK') || s.includes('TIDAK') || s.includes('GAGAL')) ? 'bg-danger-subtle text-danger'
            : 'bg-light text-muted border';
        return '<span class="badge ' + cls + '">' + escHtml(k || '-') + '</span>';
    }

    function renderBAST(r) {
        const st = r.status;
        const stBadge = st === 'COMPLETED' ? '<span class="badge-completed">Approved WH</span>'
            : st === 'REJECTED' ? '<span class="badge-rejected">Ditolak WH</span>'
            : '<span class="badge-pending">Pending WH</span>';
        const rows = r.perangkat.length
            ? `<div class="table-responsive">
                 <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.82rem;">
                   <thead class="table-light">
                     <tr><th>SN Lama</th><th>SN Baru</th><th>No. Internet</th><th>Kondisi</th></tr>
                   </thead>
                   <tbody>
                     ${r.perangkat.map(p => `<tr>
                       <td class="font-monospace text-muted">${escHtml(p.snlama || '-')}</td>
                       <td class="font-monospace text-success fw-bold">${escHtml(p.snbaru || '-')}</td>
                       <td class="font-monospace">${escHtml(p.noinet || '-')}</td>
                       <td>${kondisiBadge(p.kondisi)}</td>
                     </tr>`).join('')}
                   </tbody>
                 </table>
               </div>`
            : '<div class="text-muted small mb-2">Belum ada perangkat diisi.</div>';
        const evUrls = r.eviden.map(f => "'/uploads/eviden/" + String(f).split(/[\\/]/).pop() + "'").join(',');
        return `
          <div class="border rounded-3 p-3 mb-2" style="background:#fafbff;">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="fw-bold font-monospace text-danger" style="font-size:0.85rem;">${escHtml(r.kode_unik)}</span>
                ${stBadge}
                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>${escHtml(r.tanggal || '-')}</span>
                <span class="text-muted small"><i class="bi bi-pin-map me-1"></i>${escHtml(r.loksto || '-')}</span>
                <span class="text-muted small"><i class="bi bi-box-seam me-1"></i>WH: ${escHtml(r.wh_nama)}</span>
                <a class="ms-auto btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size:0.72rem;" href="/bast/cetak/${escAttr(r.kode_unik)}" target="_blank"><i class="bi bi-printer me-1"></i>Cetak</a>
            </div>
            ${rows}
            <div class="d-flex align-items-center gap-3 mt-2">
                ${r.eviden_count > 0 ? `<button class="btn btn-link p-0" style="font-size:0.75rem;text-decoration:none;color:#1d4ed8;" onclick="lihatEvidenAdmin([${evUrls}])"><i class="bi bi-images me-1"></i>${r.eviden_count} foto eviden — Lihat</button>` : ''}
                ${r.alasan_tolak ? `<span class="small text-danger"><i class="bi bi-x-circle me-1"></i>Alasan tolak: ${escHtml(r.alasan_tolak)}</span>` : ''}
            </div>
          </div>`;
    }

    function lihatEvidenAdmin(urls) {
        const c = document.getElementById('evidenAdminContainer');
        c.innerHTML = urls.map((u, i) => '<div class="text-center"><img src="' + u + '" class="rounded shadow" style="max-height:320px;max-width:100%;border:1px solid #ddd;" onerror="this.parentElement.innerHTML=\'<div class=\\\'text-muted small\\\'>Foto tidak ditemukan</div>\';"><div class="small text-muted mt-1">Foto ' + (i + 1) + '</div></div>').join('');
        new bootstrap.Modal(document.getElementById('modalEvidenAdmin')).show();
    }

    function filterSATable() {
        if (!saActive || !saCache[saActive]) return;
        const kw = (document.getElementById('saSearch').value || '').toLowerCase().trim();
        const dari = document.getElementById('saDari').value;
        const sampai = document.getElementById('saSampai').value;
        const data = saCache[saActive];
        const inTanggal = (tgl) => {
            const t = String(tgl || '');
            if (!t) return true;
            if (dari && t < dari) return false;
            if (sampai && t > sampai) return false;
            return true;
        };
        if (!kw && !dari && !sampai) { renderSATeknisi(data); return; }
        const filtered = {
            success: true,
            sa: data.sa,
            total_bast: 0,
            teknisi: data.teknisi
                .filter(t => {
                    if (!kw) return true;
                    // Cocokkan dengan Profil (Nama/NIK/STO)
                    const profilCocok =
                        String(t.nama || '').toLowerCase().includes(kw) ||
                        String(t.nik || '').toLowerCase().includes(kw) ||
                        String(t.sto || '').toLowerCase().includes(kw);
                    if (profilCocok) return true;
                    // Cocokkan dengan Detail BAST di dalamnya
                    return (t.records || []).some(r =>
                        inTanggal(r.tanggal) &&
                        (String(r.kode_unik || '').toLowerCase().includes(kw) ||
                         String(r.loksto || '').toLowerCase().includes(kw) ||
                         (r.perangkat || []).some(p => 
                            String(p.snlama || '').toLowerCase().includes(kw) || 
                            String(p.snbaru || '').toLowerCase().includes(kw) || 
                            String(p.noinet || '').toLowerCase().includes(kw)
                         ))
                    );
                })
                .map(t => {
                    const profilCocok = !kw ||
                        String(t.nama || '').toLowerCase().includes(kw) ||
                        String(t.nik || '').toLowerCase().includes(kw) ||
                        String(t.sto || '').toLowerCase().includes(kw);
                    
                    // Jika profil cocok, tampilkan semua BAST-nya (hanya filter tanggal)
                    // Jika profil TIDAK cocok tapi teknisi ini lolos (berarti BAST-nya yang cocok), filter BAST-nya
                    const recs = profilCocok
                        ? t.records.filter(r => inTanggal(r.tanggal))
                        : t.records.filter(r =>
                            inTanggal(r.tanggal) &&
                            (String(r.kode_unik || '').toLowerCase().includes(kw) ||
                             String(r.loksto || '').toLowerCase().includes(kw) ||
                             (r.perangkat || []).some(p => 
                                String(p.snlama || '').toLowerCase().includes(kw) || 
                                String(p.snbaru || '').toLowerCase().includes(kw) || 
                                String(p.noinet || '').toLowerCase().includes(kw)
                             ))
                        );
                    return {
                        ...t,
                        records: recs,
                        total_bast: recs.length,
                        total_ont: recs.reduce((s, r) => s + (r.perangkat || []).length, 0),
                        total_foto: recs.reduce((s, r) => s + (r.eviden_count || 0), 0)
                    };
                })
        };
        filtered.total_bast = filtered.teknisi.reduce((s, t) => s + t.total_bast, 0);
        renderSATeknisi(filtered);
    }

    function escHtml(s) {
        return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }
    function escAttr(s) {
        return String(s == null ? '' : s).replace(/'/g,"\\'").replace(/"/g,'&quot;');
    }

    // Muat jumlah per SA & auto-pilih SA pertama saat halaman siap
    muatSAMeta();
</script>

<script>
    (function () {
        function countUp(el, target) {
            var dur = 900, start = null;
            function step(now) {
                if (!start) start = now;
                var p = Math.min((now - start) / dur, 1);
                el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
                if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }
        window.setCount = function (id, target) {
            var el = document.getElementById(id);
            if (el) countUp(el, target);
        };
        function initAnim() {
            document.querySelectorAll('.anim-up').forEach(function (el, i) {
                el.style.animationDelay = (i * 80) + 'ms';
            });
            document.querySelectorAll('[data-count]').forEach(function (el) {
                countUp(el, parseInt(el.getAttribute('data-count'), 10) || 0);
            });
            if ('IntersectionObserver' in window) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) {
                        if (e.isIntersecting) { e.target.classList.add('reveal-visible'); io.unobserve(e.target); }
                    });
                }, { threshold: 0.08 });
                document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
            } else {
                document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('reveal-visible'); });
            }
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAnim);
        else initAnim();
    })();
</script>
<script>
    (function () {
        function applyDark(dark) {
            document.body.classList.toggle('dark', dark);
            var btn = document.getElementById('darkToggle');
            if (btn) btn.innerHTML = dark ? '<i class="bi bi-sun-fill"></i>' : '<i class="bi bi-moon-stars-fill"></i>';
            try { localStorage.setItem('bast_dark', dark ? '1' : '0'); } catch (e) {}
        }
        try { applyDark(localStorage.getItem('bast_dark') === '1'); } catch (e) {}
        window.toggleDark = function () { applyDark(!document.body.classList.contains('dark')); };
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function () {});
    })();
</script>

</body>
</html>