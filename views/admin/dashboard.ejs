<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Telkom Akses</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #f4f7f6; }
        .navbar-custom { background: linear-gradient(135deg, #EE2E24 0%, #b31217 100%); }
        .card-panel { background: #fff; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.02); }
        .nav-pills .nav-link.active { background-color: #EE2E24; box-shadow: 0 4px 12px rgba(238,46,36,0.3); }
        .nav-pills .nav-link { color: #475569; font-weight: 500; border-radius: 12px; transition: 0.2s; }
        .table th { background-color: #f8fafc; font-size: 0.85rem; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; }
        .badge-completed { background-color: #dcfce7; color: #166534; padding: 6px 14px; border-radius: 20px; font-weight: 500; font-size: 0.75rem; display:inline-block; }
        .badge-pending   { background-color: #fef9c3; color: #854d0e; padding: 6px 14px; border-radius: 20px; font-weight: 500; font-size: 0.75rem; display:inline-block; }
        .stat-card { border-radius: 20px; border: none; box-shadow: 0 8px 25px rgba(0,0,0,0.03); transition: all 0.3s ease; }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(0,0,0,0.08); }
        .stat-blue   { background: linear-gradient(135deg, #f0f7ff 0%, #e1effe 100%); }
        .stat-green  { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); }
        .stat-yellow { background: linear-gradient(135deg, #fefce8 0%, #fef9c3 100%); }
        .technician-card { border: 1.5px solid #e2e8f0; border-radius: 14px; margin-bottom: 15px; overflow: hidden; transition: 0.2s; background: #fff; }
        .technician-card:hover { border-color: #EE2E24; box-shadow: 0 4px 15px rgba(238,46,36,0.08); }
        .technician-header { background: #fafafa; padding: 18px 25px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
        .technician-header:hover { background: #fff5f5; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3 shadow-sm mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="#"><i class="bi bi-speedometer2 me-2"></i> DASHBOARD SUKMAJAYA</a>
        <div class="d-flex align-items-center">
            <span class="text-white me-3 fw-medium">Halo, Admin (<%= username %>)</span>
            <a href="/logout" class="btn btn-sm btn-light text-danger fw-bold rounded-pill px-3 shadow-sm">Logout</a>
        </div>
    </div>
</nav>

<div class="container-fluid px-4 mb-5">

    <!-- Statistik -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="stat-card stat-blue p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size:0.75rem;letter-spacing:0.5px;">Total Dokumen BAST</span>
                        <h2 class="fw-bold mb-0 text-primary"><%= bastData.length %></h2>
                    </div>
                    <div class="bg-primary text-white rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width:55px;height:55px;">
                        <i class="bi bi-file-earmark-text fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-green p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size:0.75rem;letter-spacing:0.5px;">Disetujui Warehouse</span>
                        <h2 class="fw-bold mb-0 text-success"><%= bastData.filter(d => d.status === 'COMPLETED').length %></h2>
                    </div>
                    <div class="bg-success text-white rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width:55px;height:55px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-yellow p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size:0.75rem;letter-spacing:0.5px;">Menunggu WH (Pending)</span>
                        <h2 class="fw-bold mb-0 text-warning-emphasis"><%= bastData.filter(d => d.status === 'PENDING').length %></h2>
                    </div>
                    <div class="bg-warning text-dark rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width:55px;height:55px;">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-4 shadow-sm d-inline-flex border" id="adminTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-4 py-2" id="rekap-tab" data-bs-toggle="pill" data-bs-target="#rekap-pane" type="button">
                <i class="bi bi-people-fill me-2"></i> Rekap Per Teknisi (ONT)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2" id="bast-tab" data-bs-toggle="pill" data-bs-target="#bast-pane" type="button">
                <i class="bi bi-file-earmark-pdf-fill me-2"></i> Download Dokumen
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-pane" type="button">
                <i class="bi bi-person-gear me-2"></i> Akun Teknisi
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2" id="namateknisi-tab" data-bs-toggle="pill" data-bs-target="#namateknisi-pane" type="button">
                <i class="bi bi-person-lines-fill me-2"></i> Nama Teknisi
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2 text-primary fw-bold" id="rekon-tab" data-bs-toggle="pill" data-bs-target="#rekon-pane" type="button">
                <i class="bi bi-magic me-2"></i> VLOOKUP Rekon Data
            </button>
        </li>
    </ul>

    <!-- ===== TAB CONTENT ===== -->
    <div class="tab-content" id="adminTabContent">

        <!-- TAB 1: REKAP PER TEKNISI -->
        <div class="tab-pane fade show active" id="rekap-pane" role="tabpanel">
            <div class="card-panel p-4">
                <!-- Header dengan tombol Download Excel HANYA di sini -->
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                    <div>
                        <h5 class="fw-bold mb-1 text-danger"><i class="bi bi-collection-fill me-2"></i> Rekapitulasi Progres ONT Berdasarkan Nama Teknisi</h5>
                        <p class="text-muted small mb-0">Klik pada nama teknisi di bawah untuk melihat rincian SN perangkat yang masuk.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold">
                            Total Teknisi: <%= Object.keys(groupedRekap).length %> Orang
                        </span>
                        <!-- TOMBOL DOWNLOAD REKAP ONT — HANYA MUNCUL DI SINI -->
                        <a href="/admin/export/rekap-ont" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">
                            <i class="bi bi-file-earmark-excel-fill me-1"></i> Download Excel Rekap ONT
                        </a>
                    </div>
                </div>

                <% if (Object.keys(groupedRekap).length === 0) { %>
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        Belum ada rekapitulasi perangkat ONT yang masuk.
                    </div>
                <% } %>

                <%
                   let indexTech = 0;
                   for (let teknisi in groupedRekap) {
                       indexTech++;
                       let items = groupedRekap[teknisi];
                %>
                <div class="technician-card">
                    <div class="technician-header" data-bs-toggle="collapse" data-bs-target="#tech-<%= indexTech %>" aria-expanded="false">
                        <div class="d-flex align-items-center">
                            <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width:45px;height:45px;">
                                <%= teknisi.charAt(0) %>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark"><%= teknisi %></h6>
                                <small class="text-muted">Total Perangkat Masuk: <b class="text-danger"><%= items.length %> Unit ONT</b></small>
                            </div>
                        </div>
                        <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill fw-medium">
                            Klik untuk Detail SN <i class="bi bi-chevron-down ms-1"></i>
                        </span>
                    </div>
                    <div id="tech-<%= indexTech %>" class="collapse">
                        <div class="p-3 bg-white border-top">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>No</th>
                                            <th>Kode BAST</th>
                                            <th>Tanggal</th>
                                            <th>STO</th>
                                            <th>Penerima (WH)</th>
                                            <th>SN Lama</th>
                                            <th>SN Baru (Masuk)</th>
                                            <th>No Internet</th>
                                            <th>Kondisi</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% items.forEach((r, idx) => { %>
                                        <tr>
                                            <td class="text-center fw-medium"><%= idx + 1 %></td>
                                            <td><span class="fw-bold font-monospace text-danger"><%= r.kode_unik %></span></td>
                                            <td><%= r.tanggal %></td>
                                            <td><%= r.loksto %></td>
                                            <td><span class="badge bg-light text-dark border"><%= r.penerima %></span></td>
                                            <td><span class="font-monospace small text-muted"><%= r.sn_lama %></span></td>
                                            <td><span class="font-monospace small fw-bold text-success"><%= r.sn_baru %></span></td>
                                            <td><%= r.no_inet %></td>
                                            <td>
                                                <% if(r.kondisi === 'Baik') { %>
                                                    <span class="badge bg-success-subtle text-success">Baik</span>
                                                <% } else { %>
                                                    <span class="badge bg-danger-subtle text-danger">Rusak</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if(r.status === 'COMPLETED') { %>
                                                    <span class="badge-completed">Selesai</span>
                                                <% } else if(r.status === 'REJECTED') { %>
                                                    <span style="background:#fee2e2;color:#991b1b;padding:6px 14px;border-radius:20px;font-weight:500;font-size:0.75rem;">Ditolak</span>
                                                <% } else { %>
                                                    <span class="badge-pending">Pending</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
        <!-- BATAS AKHIR TAB 1 -->

        <!-- TAB 2: DOWNLOAD DOKUMEN -->
        <div class="tab-pane fade" id="bast-pane" role="tabpanel">
            <div class="card-panel p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                    <div>
                        <h5 class="fw-bold mb-1 text-danger">
                            <i class="bi bi-file-earmark-arrow-down-fill me-2"></i> Download Dokumen BAST Approved Warehouse
                        </h5>
                        <p class="text-muted small mb-0">Unduh dokumen PDF yang telah disahkan WH, atau ekspor seluruh data ke Excel.</p>
                    </div>
                    <button type="button" onclick="downloadAllExcel()" class="btn btn-success fw-bold px-4 py-2 rounded-pill shadow-sm flex-shrink-0">
                        <i class="bi bi-file-earmark-excel-fill me-2"></i> Download Excel Semua Data
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="tabelBast">
                        <thead>
                            <tr>
                                <th>Kode BAST</th>
                                <th>Tanggal</th>
                                <th>STO</th>
                                <th>Teknisi</th>
                                <th>Warehouse</th>
                                <th>Status</th>
                                <th class="text-center">Aksi Unduh</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% bastData.forEach(d => { %>
                            <tr>
                                <td class="fw-bold font-monospace text-danger"><%= d.kode_unik %></td>
                                <td><%= d.tanggal %></td>
                                <td><%= d.loksto %></td>
                                <td><%= d.teknisi_nama %></td>
                                <td><%= d.wh_nama || '-' %></td>
                                <td>
                                    <% if(d.status === 'COMPLETED') { %>
                                        <span class="badge-completed">Approved (WH)</span>
                                    <% } else if(d.status === 'REJECTED') { %>
                                        <span style="background:#fee2e2;color:#991b1b;padding:6px 14px;border-radius:20px;font-weight:500;font-size:0.75rem;display:inline-block;">Ditolak WH</span>
                                    <% } else { %>
                                        <span class="badge-pending">Pending WH</span>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <% if(d.status === 'COMPLETED') { %>
                                        <a href="/bast/cetak/<%= d.kode_unik %>" target="_blank"
                                            class="btn btn-sm btn-danger rounded-pill px-3 fw-medium shadow-sm">
                                            <i class="bi bi-printer-fill me-1"></i> Buka & Cetak PDF
                                        </a>
                                    <% } else { %>
                                        <span class="text-muted small">Belum Disetujui WH</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- BATAS AKHIR TAB 2 -->

        <!-- TAB 3: AKUN TEKNISI -->
        <div class="tab-pane fade" id="users-pane" role="tabpanel">
            <div class="row">
                <div class="col-md-5 mb-4">
                    <div class="card-panel p-4">
                        <h5 class="fw-bold mb-3 text-danger"><i class="bi bi-person-plus-fill me-2"></i> Tambah Akun Teknisi Baru</h5>
                        <form action="/admin/user/add" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-medium small">Username Login</label>
                                <input type="text" class="form-control" name="username" placeholder="Contoh: andiarya" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-medium small">Password</label>
                                <input type="password" class="form-control" name="password" placeholder="Password akun" required>
                            </div>
                            <button type="submit" class="btn btn-danger w-100 fw-bold rounded-pill py-2 shadow-sm">Buat Akun Teknisi</button>
                        </form>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="card-panel p-4">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-people me-2"></i> Daftar Akun Teknisi Aktif</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>No</th>
                                        <th>Username</th>
                                        <th>Role</th>
                                        <th class="text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% teknisiList.forEach((u, i) => { %>
                                    <tr>
                                        <td><%= i + 1 %></td>
                                        <td class="fw-bold"><%= u.username %></td>
                                        <td><span class="badge bg-secondary-subtle text-secondary px-2 py-1">Teknisi</span></td>
                                        <td class="text-center">
                                            <a href="/admin/user/delete/<%= u.id %>"
                                                class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                onclick="return confirm('Yakin ingin menghapus akun ini?')">Hapus</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- BATAS AKHIR TAB 3 -->

        <!-- TAB 4: NAMA TEKNISI DROPDOWN -->
        <div class="tab-pane fade" id="namateknisi-pane" role="tabpanel">
            <div class="row">
                <div class="col-md-5 mb-4">
                    <div class="card-panel p-4">
                        <h5 class="fw-bold mb-3 text-danger">
                            <i class="bi bi-person-plus-fill me-2"></i> Tambah Nama Teknisi
                        </h5>
                        <form action="/admin/teknisi/add" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-medium small">NIK Teknisi</label>
                                <input type="text" class="form-control" name="nik" placeholder="Contoh: 26050119" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-medium small">Nama Lengkap</label>
                                <input type="text" class="form-control" name="nama" placeholder="Contoh: ANDI ARYA WIJAYA" required>
                            </div>
                            <button type="submit" class="btn btn-danger w-100 fw-bold rounded-pill py-2">
                                Tambah ke Dropdown
                            </button>
                        </form>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="card-panel p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-list-ul me-2"></i> Daftar Nama di Dropdown</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>No</th>
                                        <th>NIK</th>
                                        <th>Nama</th>
                                        <th class="text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% namaTeknisiList.forEach((t, i) => { %>
                                    <tr>
                                        <td><%= i + 1 %></td>
                                        <td class="font-monospace"><%= t.nik %></td>
                                        <td class="fw-bold"><%= t.nama %></td>
                                        <td class="text-center">
                                            <a href="/admin/teknisi/delete/<%= t.id %>"
                                                class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                onclick="return confirm('Hapus nama ini?')">Hapus</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <% if(namaTeknisiList.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">Belum ada nama teknisi</td>
                                    </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- BATAS AKHIR TAB 4 -->

        <!-- TAB 5: REKONSILIASI VLOOKUP -->
        <div class="tab-pane fade" id="rekon-pane" role="tabpanel">
            <div class="card-panel p-4 mb-4">
                <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-file-earmark-spreadsheet-fill me-2"></i> Rekonsiliasi Data Aktual vs Database BAST</h5>
                <p class="text-muted small">Blok (Ctrl+A / Ctrl+C) seluruh data Excel Anda beserta headernya, lalu paste (Ctrl+V) ke dalam kotak di bawah ini.</p>

                <textarea id="excelPasteArea" class="form-control mb-3 font-monospace" rows="5" placeholder="Paste data Excel dari kolom witel sampai valid_bayar di sini..."></textarea>

                <div class="d-flex gap-2">
                    <button type="button" onclick="prosesRekon()" class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-gear-fill me-2"></i> Proses Komparasi (VLOOKUP)
                    </button>
                    <button type="button" onclick="document.getElementById('modalContoh').style.display='flex'"
                        class="btn btn-outline-secondary fw-bold px-4 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-eye-fill me-2"></i> Lihat Contoh / Template
                    </button>
                </div>
            </div>

            <!-- Modal Contoh Template -->
            <div id="modalContoh" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
                <div style="background:#fff;border-radius:16px;padding:30px;max-width:90%;width:900px;max-height:85vh;overflow-y:auto;position:relative;">
                    <button onclick="document.getElementById('modalContoh').style.display='none'"
                        style="position:absolute;top:15px;right:15px;background:#EE2E24;color:white;border:none;border-radius:50%;width:32px;height:32px;font-size:16px;cursor:pointer;">&times;</button>
                    <h5 class="fw-bold text-primary mb-1"><i class="bi bi-file-earmark-spreadsheet me-2"></i> Contoh Format Template Excel</h5>
                    <p class="text-muted small mb-3">Pastikan header kolom Excel kamu <b>sama persis</b> seperti di bawah ini.</p>
                    <div class="mb-3 p-3 bg-danger-subtle border border-danger rounded-3">
                        <h6 class="fw-bold text-danger mb-2"><i class="bi bi-exclamation-triangle-fill me-1"></i> Kolom Wajib Ada:</h6>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge bg-danger px-3 py-2">SN_PERANGKAT_OLD</span>
                            <span class="badge bg-danger px-3 py-2">STATUS_WH</span>
                            <span class="badge bg-danger px-3 py-2">STATUS_REAL</span>
                        </div>
                    </div>
                    <div class="table-responsive border rounded-3">
                        <table class="table table-bordered table-sm align-middle mb-0" style="font-size:0.78rem;white-space:nowrap;">
                            <thead style="background:#0e294b;color:white;">
                                <tr>
                                    <th>WITEL</th><th>SERVICE_AREA</th><th>ID_STO</th><th>NO_INET</th><th>NIK</th>
                                    <th class="bg-danger">SN_PERANGKAT_OLD</th><th>TYPE_OLD</th><th>STATUS</th>
                                    <th class="bg-danger">STATUS_WH</th><th class="bg-danger">STATUS_REAL</th>
                                    <th>LAST_ACTIVITY_DATESTAMP</th><th>VALID_BAYAR</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>BEKASI</td><td>SUKMAJAYA</td><td>SKJ</td><td>122120211614</td><td>26010129</td>
