<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Telkom Akses Branch Bekasi</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        :root {
            --navy:  #0e1f3b;
            --navy2: #162d52;
            --red:   #EE2E24;
            --red2:  #c42019;
            --gold:  #f59e0b;
            --text:  #1e293b;
            --muted: #64748b;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body {
            font-family: 'Poppins', sans-serif;
            color: var(--text);
            overflow-x: hidden;
        }

        .login-wrap {
            min-height: 100vh;
            display: flex;
            background: #f0f4f8;
            position: relative;
        }

        /* ══════════ BRAND PANEL (kiri) ══════════ */
        .brand-panel {
            width: 46%;
            min-height: 100vh;
            background:
                radial-gradient(1100px 600px at 85% -10%, rgba(238,46,36,.28), transparent 60%),
                radial-gradient(900px 500px at -10% 110%, rgba(245,158,11,.14), transparent 60%),
                linear-gradient(150deg, var(--navy) 0%, #12264a 45%, var(--navy2) 100%);
            color: #fff;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2.5rem;
            animation: panelLeft .8s cubic-bezier(.22,1,.36,1) both;
        }
        .brand-panel::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
            background-size: 46px 46px;
            pointer-events: none;
        }

        /* bentuk geometris melayang */
        .shape { position: absolute; border-radius: 20px; opacity: .5; pointer-events: none; }
        .shape.s1 {
            width: 130px; height: 130px; top: 8%; left: 6%;
            background: linear-gradient(135deg, rgba(238,46,36,.5), rgba(238,46,36,.08));
            animation: floatY 9s ease-in-out infinite;
        }
        .shape.s2 {
            width: 70px; height: 70px; bottom: 14%; left: 16%;
            background: rgba(245,158,11,.35);
            border-radius: 16px;
            transform: rotate(20deg);
            animation: floatY 11s ease-in-out 1.2s infinite;
        }
        .shape.s3 {
            width: 46px; height: 46px; top: 60%; right: 8%;
            background: rgba(59,130,246,.4);
            border-radius: 50%;
            animation: floatY 8s ease-in-out .6s infinite;
        }
        .shape.s4 {
            width: 18px; height: 18px; top: 22%; right: 22%;
            background: rgba(255,255,255,.5);
            border-radius: 50%;
            animation: pulseDot 3.5s ease-in-out infinite;
        }

        .brand-inner { position: relative; z-index: 2; max-width: 420px; }

        .brand-logo {
            display: inline-flex; align-items: center; justify-content: center;
            background: var(--red);
            color: #fff;
            font-weight: 800;
            font-size: 1.05rem;
            letter-spacing: 1px;
            padding: 10px 18px;
            border-radius: 12px;
            box-shadow: 0 10px 24px rgba(238,46,36,.35);
            margin-bottom: 26px;
            animation: rise .7s cubic-bezier(.22,1,.36,1) .15s both;
        }

        .brand-title {
            font-size: 2.4rem;
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: .3px;
            animation: rise .7s cubic-bezier(.22,1,.36,1) .28s both;
        }
        .brand-title span { color: var(--red); }

        .branch-badge {
            display: inline-flex; align-items: center; gap: 8px;
            margin-top: 14px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 999px;
            padding: 7px 16px;
            font-size: .8rem;
            font-weight: 600;
            letter-spacing: 2.5px;
            color: #fbbf24;
            animation: rise .7s cubic-bezier(.22,1,.36,1) .4s both;
        }

        .brand-sub {
            margin-top: 18px;
            color: rgba(255,255,255,.72);
            font-size: .95rem;
            font-weight: 300;
            line-height: 1.7;
            animation: rise .7s cubic-bezier(.22,1,.36,1) .52s both;
        }

        .feature-list {
            list-style: none;
            margin-top: 26px;
            display: grid;
            gap: 12px;
            animation: rise .7s cubic-bezier(.22,1,.36,1) .64s both;
        }
        .feature-list li {
            display: flex; align-items: center; gap: 12px;
            font-size: .9rem; font-weight: 400;
            color: rgba(255,255,255,.88);
        }
        .feature-list li i {
            width: 30px; height: 30px; flex-shrink: 0;
            display: inline-flex; align-items: center; justify-content: center;
            background: rgba(34,197,94,.16);
            color: #4ade80;
            border-radius: 9px;
            font-size: .9rem;
        }

        .brand-footer {
            position: absolute; z-index: 2;
            bottom: 26px; left: 0; right: 0;
            text-align: center;
            font-size: .72rem;
            color: rgba(255,255,255,.5);
            letter-spacing: .5px;
        }

        /* ══════════ FORM PANEL (kanan) ══════════ */
        .form-panel {
            flex: 1;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1.5rem;
            animation: panelRight .8s cubic-bezier(.22,1,.36,1) both;
        }
        .login-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border: 1px solid #e6ebf2;
            border-radius: 22px;
            padding: 2.6rem 2.4rem;
            box-shadow: 0 24px 60px rgba(14,31,59,.12);
            position: relative;
        }
        .login-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--navy), var(--red), var(--gold));
            border-radius: 22px 22px 0 0;
        }

        .card-icon {
            width: 62px; height: 62px;
            margin: 0 auto 18px;
            display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, var(--navy), var(--navy2));
            color: #fff;
            font-size: 1.7rem;
            border-radius: 18px;
            box-shadow: 0 12px 26px rgba(14,31,59,.3);
            animation: rise .7s cubic-bezier(.22,1,.36,1) .2s both;
        }

        .card-title {
            text-align: center;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--text);
            animation: rise .7s cubic-bezier(.22,1,.36,1) .3s both;
        }
        .card-sub {
            text-align: center;
            font-size: .85rem;
            color: var(--muted);
            margin: 6px 0 26px;
            animation: rise .7s cubic-bezier(.22,1,.36,1) .4s both;
        }

        .alert-err {
            display: flex; align-items: center; gap: 10px;
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
            border-radius: 12px;
            padding: 10px 14px;
            font-size: .8rem;
            margin-bottom: 18px;
            animation: shake .4s ease both;
        }

        .form-group {
            position: relative;
            margin-bottom: 20px;
            animation: rise .7s cubic-bezier(.22,1,.36,1) .5s both;
        }
        .form-group label {
            display: block;
            font-size: .78rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 8px;
        }
        .input-wrap { position: relative; }
        .input-wrap > i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: .95rem;
            pointer-events: none;
            transition: color .2s;
        }
        .input-wrap input {
            width: 100%;
            padding: 13px 46px 13px 44px;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            font-family: 'Poppins', sans-serif;
            font-size: .9rem;
            color: var(--text);
            background: #f8fafc;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }
        .input-wrap input::placeholder { color: #b0b9c6; font-weight: 300; }
        .input-wrap input:focus {
            outline: none;
            border-color: var(--red);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(238,46,36,.1);
        }
        .input-wrap input:focus ~ i { color: var(--red); }

        .toggle-pw {
            position: absolute;
            right: 8px; top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #94a3b8;
            font-size: 1rem;
            width: 36px; height: 36px;
            border-radius: 10px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: color .2s, background .2s;
        }
        .toggle-pw:hover { color: var(--red); background: #fff1f1; }

        .btn-login {
            width: 100%;
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: .92rem;
            letter-spacing: 1px;
            color: #fff;
            background: linear-gradient(135deg, var(--red) 0%, var(--red2) 100%);
            box-shadow: 0 12px 26px rgba(238,46,36,.32);
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 10px;
            transition: transform .2s, box-shadow .2s, filter .2s;
            animation: rise .7s cubic-bezier(.22,1,.36,1) .6s both;
        }
        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 16px 34px rgba(238,46,36,.4); }
        .btn-login:active { transform: translateY(0); }
        .btn-login:disabled { opacity: .85; cursor: progress; filter: saturate(.7); }
        .spinner-border {
            width: 18px; height: 18px;
            border: 2.5px solid rgba(255,255,255,.4);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
            display: none;
        }
        .btn-login.loading .spinner-border { display: inline-block; }

        .card-footer {
            text-align: center;
            margin-top: 22px;
            font-size: .76rem;
            color: var(--muted);
            animation: rise .7s cubic-bezier(.22,1,.36,1) .7s both;
        }
        .card-footer strong { color: var(--navy); font-weight: 600; }

        /* ══════════ ANIMASI ══════════ */
        @keyframes panelLeft {
            from { opacity: 0; transform: translateX(-40px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes panelRight {
            from { opacity: 0; transform: translateX(40px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes rise {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes floatY {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50%      { transform: translateY(-22px) rotate(8deg); }
        }
        @keyframes pulseDot {
            0%, 100% { opacity: .2; transform: scale(.7); }
            50%      { opacity: .8; transform: scale(1.15); }
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-6px); }
            50% { transform: translateX(5px); }
            75% { transform: translateX(-3px); }
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ══════════ RESPONSIVE ══════════ */
        @media (max-width: 900px) {
            .login-wrap { flex-direction: column; }
            .brand-panel {
                width: 100%;
                min-height: auto;
                padding: 2rem 1.5rem 1.6rem;
            }
            .brand-inner { max-width: 480px; text-align: left; }
            .brand-title { font-size: 1.7rem; }
            .feature-list { display: none; }
            .brand-footer { display: none; }
            .form-panel { min-height: auto; padding: 2rem 1rem 2.5rem; }
            .login-card { max-width: 420px; padding: 2.2rem 1.6rem; }
        }

        @media (prefers-reduced-motion: reduce) {
            .brand-panel, .form-panel, .brand-logo, .brand-title, .branch-badge,
            .brand-sub, .feature-list, .card-icon, .card-title, .card-sub,
            .form-group, .btn-login, .card-footer, .alert-err, .shape {
                animation: none !important;
            }
            .btn-login, .toggle-pw { transition: none !important; }
        }
    </style>
</head>
<body>
    <div class="login-wrap">

        <!-- PANEL KIRI: BRAND -->
        <div class="brand-panel">
            <div class="shape s1"></div>
            <div class="shape s2"></div>
            <div class="shape s3"></div>
            <div class="shape s4"></div>

            <div class="brand-inner">
                <div class="brand-logo">BAST</div>
                <div class="brand-title">Telkom <span>Akses</span></div>
                <div class="branch-badge"><i class="bi bi-geo-alt-fill"></i> BRANCH BEKASI</div>
                <p class="brand-sub">
                    Sistem Monitoring BAST Replacement<br>
                    Digitalisasi dan validasi Berita Acara Serah Terima perangkat ONT.
                </p>
                <ul class="feature-list">
                    <li><i class="bi bi-check-lg"></i> Monitoring BAST Replacement realtime</li>
                    <li><i class="bi bi-check-lg"></i> Persetujuan &amp; tanda tangan Warehouse</li>
                    <li><i class="bi bi-check-lg"></i> Rekapitulasi ONT &amp; foto eviden</li>
                    <li><i class="bi bi-check-lg"></i> Laporan migrasi per Service Area</li>
                </ul>
            </div>
            <div class="brand-footer">&copy; 2026 PT Telkom Akses &mdash; Branch Bekasi</div>
        </div>

        <!-- PANEL KANAN: FORM LOGIN -->
        <div class="form-panel">
            <div class="login-card">
                <div class="card-icon"><i class="bi bi-shield-lock-fill"></i></div>
                <h1 class="card-title">Masuk Admin</h1>
                <p class="card-sub">Silakan login untuk mengakses sistem</p>

                <% if (error) { %>
                    <div class="alert-err"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
                <% } %>

                <form action="/login" method="POST" id="loginForm" autocomplete="on">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <div class="input-wrap">
                            <i class="bi bi-person-fill"></i>
                            <input type="text" id="username" name="username" placeholder="Masukkan username" autofocus required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock-fill"></i>
                            <input type="password" id="password" name="password" placeholder="Masukkan password" required>
                            <button type="button" class="toggle-pw" id="togglePw" aria-label="Tampilkan / sembunyikan password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-login" id="btnLogin">
                        <span class="spinner-border"></span>
                        <span id="btnText"><i class="bi bi-box-arrow-in-right me-1"></i> MASUK SYSTEM</span>
                    </button>
                </form>

                <div class="card-footer">
                    Ada kendala akses? Hubungi <strong>Administrator</strong>.
                </div>
            </div>
        </div>
    </div>

    <script>
        // Tampilkan / sembunyikan password
        (function () {
            var toggle = document.getElementById('togglePw');
            var input  = document.getElementById('password');
            toggle.addEventListener('click', function () {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                toggle.innerHTML = show
                    ? '<i class="bi bi-eye-slash"></i>'
                    : '<i class="bi bi-eye"></i>';
            });

            // Loading state saat submit
            var form = document.getElementById('loginForm');
            var btn  = document.getElementById('btnLogin');
            form.addEventListener('submit', function () {
                btn.disabled = true;
                btn.classList.add('loading');
                document.getElementById('btnText').textContent = ' MEMPROSES...';
            });
        })();
    </script>
</body>
</html>
