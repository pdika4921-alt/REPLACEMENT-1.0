<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Admin - Telkom Akses</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { font-family: 'Poppins', sans-serif; background: linear-gradient(135deg, #EE2E24 0%, #b31217 100%); height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: #ffffff; border-radius: 20px; box-shadow: 0 15px 35px rgba(0,0,0,0.2); padding: 3rem 2.5rem; width: 100%; max-width: 400px; text-align: center; }
        .logo-icon { font-size: 3.5rem; color: #EE2E24; margin-bottom: 10px; }
        .form-control { border-radius: 12px; padding: 12px 15px; background: #f8fafc; border: 1.5px solid #e2e8f0; }
        .form-control:focus { border-color: #EE2E24; box-shadow: 0 0 0 4px rgba(238, 46, 36, 0.1); }
        .btn-login { background: #EE2E24; color: white; border-radius: 12px; padding: 12px; font-weight: 600; width: 100%; border: none; transition: 0.3s; margin-top: 10px; }
        .btn-login:hover { background: #c41230; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(238, 46, 36, 0.3); color: white; }
    </style>
</head>
<body>
    <div class="login-card">
        <i class="bi bi-shield-lock-fill logo-icon"></i>
        <h4 class="fw-bold text-dark mb-1">Admin Panel</h4>
        <p class="text-muted mb-4 small">Sistem Monitoring BAST Replacement</p>
        
        <% if (error) { %>
            <div class="alert alert-danger p-2 text-center small border-0 rounded-3 mb-3"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3 text-start">
                <label class="fw-medium text-secondary small mb-1">Username</label>
                <input type="text" name="username" class="form-control" placeholder="Masukkan username" required>
            </div>
            <div class="mb-4 text-start">
                <label class="fw-medium text-secondary small mb-1">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Masukkan password" required>
            </div>
            <button type="submit" class="btn-login"><i class="bi bi-box-arrow-in-right me-1"></i> MASUK SYSTEM</button>
        </form>
    </div>
</body>
</html>