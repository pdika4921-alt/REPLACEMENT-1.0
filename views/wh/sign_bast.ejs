<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tanda Tangan WH - <%= data.kode_unik %></title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
    :root {
        --navy:  #0e1f3b;
        --navy2: #162d52;
        --red:   #EE2E24;
        --red2:  #c42019;
        --surface: #f0f4f8;
        --card:    #ffffff;
        --border:  #dde3ec;
        --text:    #1e293b;
        --muted:   #64748b;
    }

    body { font-family: 'Poppins', sans-serif; background: var(--surface); color: var(--text); }

    .navbar-custom {
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy2) 100%);
        border-bottom: 3px solid var(--red);
    }

    /* ---- CARD ---- */
    .card-section {
        background: var(--card);
        border-radius: 18px;
        border: 1px solid var(--border);
        box-shadow: 0 2px 16px rgba(14,31,59,0.05);
        margin-bottom: 20px;
    }
    .card-section .section-head {
        padding: 18px 24px 0;
        border-bottom: 1px solid #f1f5f9;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-bottom: 14px;
    }
    .section-head .section-icon {
        width: 38px; height: 38px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; flex-shrink: 0;
    }
    .section-icon.red   { background: #fee2e2; color: var(--red); }
    .section-icon.blue  { background: #eff6ff; color: #3b82f6; }
    .section-icon.navy  { background: #e8edf5; color: var(--navy); }
    .section-icon.green { background: #f0fdf4; color: #16a34a; }

    /* ---- INFO GRID ---- */
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 18px 24px; }
    .info-item .label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); font-weight: 600; margin-bottom: 3px; }
    .info-item .value { font-size: 0.9rem; font-weight: 700; color: var(--text); }
    .value.mono { font-family: monospace; color: var(--red); }

    /* ---- TABLE ---- */
    .table th {
        background: var(--navy); color: rgba(255,255,255,0.85);
        font-size: 0.72rem; text-transform: uppercase;
        letter-spacing: .5px; font-weight: 600; border: none;
    }
    .table td { font-size: 0.85rem; border-color: #f1f5f9; }

    /* ---- TTD CANVAS ---- */
    .ttd-wrapper {
        position: relative;
        width: 100%;
        min-height: 280px;
        background: #fafbff;
        border: 2px dashed #c7d2fe;
        border-radius: 14px;
        overflow: hidden;
        cursor: crosshair;
        transition: border-color .2s;
    }
    .ttd-wrapper:hover { border-color: var(--red); }
    .ttd-wrapper.active { border-color: var(--red); border-style: solid; }
    #signatureCanvas { display: block; width: 100%; touch-action: none; }
    .ttd-placeholder {
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        color: #c7d2fe; font-size: 0.88rem;
        pointer-events: none; text-align: center;
    }
    .ttd-placeholder i { font-size: 2.5rem; display: block; margin-bottom: 8px; }

    /* ---- WH IDENTITY CARD ---- */
    .wh-identity {
        background: linear-gradient(135deg, var(--navy) 0%, #1e4080 100%);
        border-radius: 14px; padding: 18px 22px;
        display: flex; align-items: center; gap: 16px; color: #fff;
    }
    .wh-avatar {
        width: 52px; height: 52px; border-radius: 14px;
        background: rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; font-weight: 800; flex-shrink: 0;
    }
    .wh-name { font-weight: 700; font-size: 1rem; }
    .wh-nik  { font-size: 0.78rem; opacity: .7; font-family: monospace; }
    .wh-badge {
        margin-left: auto; background: var(--red);
        border-radius: 8px; padding: 4px 12px;
        font-size: 0.72rem; font-weight: 700; letter-spacing: .5px;
    }

    /* ---- EVIDEN ---- */
    .eviden-grid { display: flex; flex-wrap: wrap; gap: 10px; padding: 16px 24px; }
    .eviden-item { position: relative; }
    .eviden-item img {
        width: 110px; height: 82px; object-fit: cover;
        border-radius: 10px; border: 2px solid var(--border);
        cursor: pointer; transition: border-color .2s, transform .2s;
    }
    .eviden-item img:hover { border-color: var(--red); transform: scale(1.04); }
    .eviden-number {
        position: absolute; top: 5px; left: 5px;
        background: rgba(238,46,36,0.85); color: #fff;
        font-size: 0.62rem; font-weight: 700; padding: 2px 7px; border-radius: 8px;
    }

    /* ---- BTN ---- */
    .btn-submit-ttd {
        background: linear-gradient(135deg, var(--red) 0%, var(--red2) 100%);
        color: #fff; border: none; border-radius: 14px; font-weight: 700;
        font-size: 1rem; padding: 16px 0; width: 100%;
        box-shadow: 0 6px 20px rgba(238,46,36,0.3);
        transition: transform .2s, box-shadow .2s;
    }
    .btn-submit-ttd:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(238,46,36,0.4);
    }
    .btn-clear {
        background: transparent; border: 1.5px solid var(--border);
        border-radius: 10px; color: var(--muted); font-weight: 600;
        font-size: 0.85rem; padding: 9px 22px; transition: all .2s;
    }
    .btn-clear:hover { border-color: var(--red); color: var(--red); background: #fff0f0; }

    /* ===== POLISH & ANIMATION ===== */
    body { overflow-x: hidden; }

    .bg-deco { position: fixed; border-radius: 50%; filter: blur(60px); opacity: .16; pointer-events: none; z-index: 0; }
    .bg-deco.d1 { width: 360px; height: 360px; top: -80px; right: -70px; background: var(--red); animation: floatBlob 12s ease-in-out infinite; }
    .bg-deco.d2 { width: 300px; height: 300px; bottom: -80px; left: -70px; background: var(--navy); animation: floatBlob 14s ease-in-out 2.2s infinite; }

    .navbar, .container { position: relative; z-index: 1; }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes floatBlob { 0%, 100% { transform: translate(0,0) scale(1); } 50% { transform: translate(26px,-22px) scale(1.07); } }

    .anim-up { opacity: 0; animation: fadeUp .6s cubic-bezier(.22,1,.36,1) both; }

    .card-section { transition: transform .2s, box-shadow .2s; }
    .card-section:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(14,31,59,.09); }

    .ttd-wrapper { transition: border-color .2s, box-shadow .3s, background .3s; }
    .ttd-wrapper.active { box-shadow: 0 0 0 4px rgba(238,46,36,.12), inset 0 0 30px rgba(238,46,36,.05); }

    .btn-submit-ttd { animation: pulseCta 2.4s ease-in-out infinite; }
    @keyframes pulseCta { 0%, 100% { box-shadow: 0 6px 20px rgba(238,46,36,.3); } 50% { box-shadow: 0 6px 32px rgba(238,46,36,.55); } }

    .eviden-item img { transition: transform .2s, box-shadow .2s, border-color .2s; }
    .eviden-item:hover img { transform: translateY(-4px) scale(1.05); box-shadow: 0 10px 22px rgba(14,31,59,.15); }

    @media (prefers-reduced-motion: reduce) {
        .anim-up, .bg-deco, .btn-submit-ttd { animation: none !important; transition: none !important; }
        .anim-up { opacity: 1; }
        .bg-deco { display: none; }
    }

    /* TOAST */
    .toast-wrap { position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; }
    .toast-box {
        background: #1e293b; color: #fff; border-radius: 12px; padding: 12px 18px;
        font-size: .82rem; font-weight: 500; box-shadow: 0 12px 28px rgba(14,31,59,.25);
        display: flex; align-items: center; gap: 10px; min-width: 240px;
        animation: toastIn .35s cubic-bezier(.22,1,.36,1) both;
    }
    .toast-box.err { background: var(--red); }
    .toast-box.ok  { background: #16a34a; }
    @keyframes toastIn { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
</style>
</head>
<body>

<div class="toast-wrap" id="toastWrap"></div>

<div class="bg-deco d1"></div>
<div class="bg-deco d2"></div>

<nav class="navbar navbar-dark navbar-custom py-3 mb-4 anim-up">
    <div class="container" style="max-width:800px;">
        <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/wh/dashboard">
            <i class="bi bi-arrow-left"></i>
            <span class="fw-semibold" style="font-size:0.9rem;">Kembali ke Dashboard</span>
        </a>
        <span class="text-white opacity-75 small"><%= data.kode_unik %></span>
    </div>
</nav>

<div class="container mb-5" style="max-width: 800px;">

    <!-- 1. INFO DOKUMEN -->
    <div class="card-section anim-up">
        <div class="section-head">
            <div class="section-icon red"><i class="bi bi-file-earmark-check-fill"></i></div>
            <div>
                <div class="fw-bold" style="font-size:0.95rem;">Detail Dokumen BAST</div>
                <div class="text-muted" style="font-size:0.78rem;">Verifikasi informasi sebelum menandatangani</div>
            </div>
        </div>
        <div class="info-grid">
            <div class="info-item">
                <div class="label">Kode BAST</div>
                <div class="value mono"><%= data.kode_unik %></div>
            </div>
            <div class="info-item">
                <div class="label">Tanggal</div>
                <div class="value"><%= data.tanggal %></div>
            </div>
            <div class="info-item">
                <div class="label">Lokasi STO</div>
                <div class="value"><%= data.loksto %></div>
            </div>
            <div class="info-item">
                <div class="label">Teknisi</div>
                <div class="value"><%= data.teknisi_nama %></div>
            </div>
        </div>
    </div>

    <!-- 2. DAFTAR ONT -->
    <div class="card-section anim-up">
        <div class="section-head">
            <div class="section-icon blue"><i class="bi bi-cpu-fill"></i></div>
            <div>
                <div class="fw-bold" style="font-size:0.95rem;">Daftar Perangkat ONT</div>
                <div class="text-muted" style="font-size:0.78rem;">Periksa kesesuaian SN sebelum menyetujui</div>
            </div>
        </div>
        <div class="p-4 pt-3">
            <% if (data.perangkat && data.perangkat.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" style="font-size:0.83rem;">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:36px;">No</th>
                            <th>SN Lama</th>
                            <th>SN Baru</th>
                            <th>No. Internet</th>
                            <th class="text-center">Kondisi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% data.perangkat.forEach((item, idx) => { %>
                        <tr>
                            <td class="text-center text-muted fw-semibold"><%= idx + 1 %></td>
                            <td class="font-monospace text-muted" style="font-size:0.8rem;"><%= item.snlama || '-' %></td>
                            <td class="font-monospace fw-bold text-success" style="font-size:0.8rem;"><%= item.snbaru || '-' %></td>
                            <td><%= item.noinet || '-' %></td>
                            <td class="text-center">
                                <% if (item.kondisi && item.kondisi.toUpperCase().includes('BAIK')) { %>
                                    <span style="background:#dcfce7;color:#166534;padding:3px 12px;border-radius:8px;font-size:0.72rem;font-weight:600;">Baik</span>
                                <% } else { %>
                                    <span style="background:#fee2e2;color:#991b1b;padding:3px 12px;border-radius:8px;font-size:0.72rem;font-weight:600;"><%= item.kondisi || '-' %></span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <td colspan="5" class="text-end small fw-semibold text-muted">
                                Total: <strong class="text-danger"><%= data.perangkat.length %> ONT</strong>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <% } else { %>
                <div class="alert alert-warning py-2 small mb-0 border-0 rounded-3">
                    <i class="bi bi-exclamation-triangle me-1"></i> Tidak ada data perangkat.
                </div>
            <% } %>
        </div>
    </div>

    <!-- 3. FOTO EVIDEN -->
    <div class="card-section anim-up">
        <div class="section-head">
            <div class="section-icon navy"><i class="bi bi-images"></i></div>
            <div>
                <div class="fw-bold" style="font-size:0.95rem;">Foto Eviden Lapangan</div>
                <div class="text-muted" style="font-size:0.78rem;">Klik foto untuk memperbesar</div>
            </div>
        </div>
        <% if (data.eviden && data.eviden.length > 0) { %>
            <div class="eviden-grid">
                <% data.eviden.forEach((path, idx) => { %>
                <div class="eviden-item">
                    <span class="eviden-number">Foto <%= idx + 1 %></span>
                    <img src="/uploads/eviden/<%= String(path).split(/[\\/]/).pop() %>"
                         alt="Eviden <%= idx + 1 %>"
                         onclick="bukaFoto(this.src)"
                         title="Klik untuk perbesar">
                </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="p-4 pt-2">
                <div class="alert alert-secondary py-2 small mb-0 border-0 rounded-3">
                    <i class="bi bi-image me-1"></i> Tidak ada foto eviden.
                </div>
            </div>
        <% } %>
    </div>

    <!-- 4. IDENTITAS PENERIMA WH -->
    <div class="card-section anim-up">
        <div class="section-head">
            <div class="section-icon green"><i class="bi bi-person-badge-fill"></i></div>
            <div>
                <div class="fw-bold" style="font-size:0.95rem;">Penerima (Warehouse)</div>
                <div class="text-muted" style="font-size:0.78rem;">Identitas otomatis dari akun yang login</div>
            </div>
        </div>
        <div class="p-4 pt-3">
            <div class="wh-identity">
                <div class="wh-avatar"><%= username.charAt(0).toUpperCase() %></div>
                <div>
                    <div class="wh-name"><%= data.wh_nama_session || username %></div>
                    <div class="wh-nik">NIK: <%= data.wh_nik_session || '-' %></div>
                </div>
                <span class="wh-badge">WH · PENERIMA</span>
            </div>
            <div class="mt-2 small text-muted">
                <i class="bi bi-info-circle me-1"></i>
                Nama ini akan otomatis tercetak di dokumen BAST sebagai pihak penerima.
            </div>
        </div>
    </div>

    <!-- 5. AREA TANDA TANGAN -->
    <div class="card-section anim-up">
        <div class="section-head">
            <div class="section-icon red"><i class="bi bi-pen-fill"></i></div>
            <div>
                <div class="fw-bold" style="font-size:0.95rem;">Tanda Tangan Warehouse</div>
                <div class="text-muted" style="font-size:0.78rem;">Tanda tangani di mana saja dalam kotak</div>
            </div>
        </div>
        <div class="p-4 pt-3">
            <div class="ttd-wrapper" id="ttdWrapper">
                <canvas id="signatureCanvas"></canvas>
                <div class="ttd-placeholder" id="ttdPlaceholder">
                    <i class="bi bi-pen"></i>
                    Tanda tangan di sini
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="button" onclick="clearCanvas()" class="btn-clear">
                    <i class="bi bi-eraser me-1"></i> Ulangi
                </button>
            </div>
        </div>
    </div>

    <!-- 6. TOMBOL SUBMIT -->
    <div class="d-grid mt-2 anim-up">
        <button type="button" onclick="submitTTD()" class="btn-submit-ttd">
            <i class="bi bi-check-circle-fill me-2"></i> Setujui &amp; Simpan Tanda Tangan
        </button>
    </div>

</div>

<!-- MODAL POPUP FOTO EVIDEN -->
<div class="modal fade" id="modalFoto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center position-relative p-0">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <img id="fotoModal" src="" class="img-fluid rounded shadow-lg" alt="Zoom Eviden" style="max-height: 85vh;">
            </div>
        </div>
    </div>
</div>

<form id="formSubmit" action="/wh/submit" method="POST" style="display:none;">
    <input type="hidden" name="kode_unik" value="<%= data.kode_unik %>">
    <input type="hidden" name="ttdPenerimaBase64" id="ttdDataInput">
</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const wrapper     = document.getElementById('ttdWrapper');
    const canvas      = document.getElementById('signatureCanvas');
    const ctx         = canvas.getContext('2d');
    const placeholder = document.getElementById('ttdPlaceholder');

    function setupCanvas() {
        const cssW = wrapper.clientWidth;
        const cssH = 280;
        const dpr  = window.devicePixelRatio || 1;
        canvas.width        = cssW * dpr;
        canvas.height       = cssH * dpr;
        canvas.style.width  = cssW + 'px';
        canvas.style.height = cssH + 'px';
        ctx.scale(dpr, dpr);
        ctx.strokeStyle = '#0e1f3b';  
        ctx.lineWidth   = 2.5;
        ctx.lineCap     = 'round';
        ctx.lineJoin    = 'round';
    }
    setupCanvas();
    window.addEventListener('resize', () => { setupCanvas(); hasSigned = false; });

    let drawing = false, hasSigned = false;

    function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        if (e.touches) return { x: e.touches[0].clientX - rect.left, y: e.touches[0].clientY - rect.top };
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    function startDraw(e) {
        e.preventDefault(); drawing = true;
        const pos = getPos(e);
        ctx.beginPath(); ctx.moveTo(pos.x, pos.y);
        if (!hasSigned) {
            hasSigned = true;
            placeholder.style.display = 'none';
            wrapper.classList.add('active');
        }
    }
    function draw(e) {
        if (!drawing) return;
        e.preventDefault();
        const pos = getPos(e);
        ctx.lineTo(pos.x, pos.y); ctx.stroke();
    }
    function stopDraw(e) {
        if (!drawing) return;
        e.preventDefault(); drawing = false; ctx.closePath();
    }

    canvas.addEventListener('mousedown',  startDraw);
    canvas.addEventListener('mousemove',  draw);
    canvas.addEventListener('mouseup',    stopDraw);
    canvas.addEventListener('mouseleave', stopDraw);
    canvas.addEventListener('touchstart', startDraw, { passive: false });
    canvas.addEventListener('touchmove',  draw,      { passive: false });
    canvas.addEventListener('touchend',   stopDraw,  { passive: false });

    function clearCanvas() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        hasSigned = false;
        placeholder.style.display = '';
        wrapper.classList.remove('active');
    }

    function submitTTD() {
        if (!hasSigned) {
            showToast('Harap tanda tangani terlebih dahulu.', 'err');
            return;
        }
        const dataURL = canvas.toDataURL('image/png');
        document.getElementById('ttdDataInput').value = dataURL;
        document.getElementById('formSubmit').submit();
    }

    function showToast(msg, type) {
        const wrap = document.getElementById('toastWrap');
        const t = document.createElement('div');
        t.className = 'toast-box ' + (type || '');
        t.innerHTML = (type === 'err' ? '<i class="bi bi-exclamation-triangle-fill"></i>' : '<i class="bi bi-check-circle-fill"></i>') + '<span>' + msg + '</span>';
        wrap.appendChild(t);
        setTimeout(() => { t.style.opacity = '0'; t.style.transition = 'opacity .3s'; }, 2600);
        setTimeout(() => t.remove(), 3000);
    }

    function bukaFoto(src) {
        document.getElementById('fotoModal').src = src;
        new bootstrap.Modal(document.getElementById('modalFoto')).show();
    }
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.anim-up').forEach(function (el, i) {
            el.style.animationDelay = (i * 70) + 'ms';
        });
    });
</script>

</body>
</html>