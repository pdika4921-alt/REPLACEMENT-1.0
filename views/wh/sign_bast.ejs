<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tanda Tangan WH - <%= data.kode_unik %></title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { font-family: 'Poppins', sans-serif; background: #f8fafc; }
        .navbar-custom { background: linear-gradient(135deg, #EE2E24 0%, #b31217 100%); }

        /* PERBAIKAN UTAMA: Canvas TTD diperlebar penuh, tidak ada elemen lain menghalangi */
        .ttd-wrapper {
            position: relative;
            width: 100%;
            background: #fff;
            border: 2px dashed #EE2E24;
            border-radius: 12px;
            overflow: hidden;
            cursor: crosshair;
        }
        #signatureCanvas {
            display: block;
            width: 100%;
            /* Tinggi canvas diset via JS agar proporsional */
            touch-action: none; /* Cegah scroll saat TTD di mobile */
        }
        .ttd-placeholder {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #cbd5e1;
            font-size: 0.9rem;
            pointer-events: none; /* Klik tetap diteruskan ke canvas di bawahnya */
            text-align: center;
            white-space: nowrap;
        }
        .ttd-placeholder i { font-size: 2rem; display: block; margin-bottom: 6px; }
        .card-info { background: #fff; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
    </style>
</head>
<body>
<nav class="navbar navbar-dark navbar-custom py-3 shadow-sm mb-4">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/wh/dashboard"><i class="bi bi-arrow-left me-2"></i> Kembali ke Dashboard WH</a>
    </div>
</nav>

<div class="container mb-5" style="max-width: 750px;">

    <!-- Info Dokumen -->
    <div class="card-info p-4 mb-4">
        <h5 class="fw-bold text-danger mb-3"><i class="bi bi-file-earmark-check me-2"></i> Detail Dokumen BAST</h5>
        <div class="row g-2 small">
            <div class="col-6">
                <span class="text-muted">Kode BAST</span>
                <div class="fw-bold font-monospace text-danger"><%= data.kode_unik %></div>
            </div>
            <div class="col-6">
                <span class="text-muted">Tanggal</span>
                <div class="fw-bold"><%= data.tanggal %></div>
            </div>
            <div class="col-6">
                <span class="text-muted">Lokasi STO</span>
                <div class="fw-bold"><%= data.loksto %></div>
            </div>
            <div class="col-6">
                <span class="text-muted">Nama Teknisi</span>
                <div class="fw-bold"><%= data.teknisi_nama %></div>
            </div>
        </div>
    </div>

    <!-- Area Tanda Tangan -->
    <div class="card-info p-4 mb-4">
        <h5 class="fw-bold mb-1">Tanda Tangan Warehouse</h5>
        <p class="text-muted small mb-3">
            <i class="bi bi-info-circle me-1"></i>
            Tanda tangani <strong>di mana saja dalam kotak</strong> di bawah ini — tidak perlu di pinggir.
        </p>

        <div class="ttd-wrapper" id="ttdWrapper">
            <canvas id="signatureCanvas"></canvas>
            <div class="ttd-placeholder" id="ttdPlaceholder">
                <i class="bi bi-pen"></i>
                Tanda tangan di sini
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="button" onclick="clearCanvas()" class="btn btn-outline-secondary rounded-pill px-4 fw-medium">
                <i class="bi bi-eraser me-1"></i> Ulangi
            </button>
        </div>
    </div>

    <!-- Nama Penerima -->
    <div class="card-info p-4 mb-4">
        <label class="form-label fw-bold">Nama Penerima (WH) <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="namaPenerima"
            value="<%= username %>"
            placeholder="Nama lengkap pihak warehouse" required>
        <div class="form-text">Nama ini akan tercetak di dokumen BAST sebagai pihak penerima.</div>
    </div>

    <!-- Tombol Submit -->
    <div class="d-grid">
        <button type="button" onclick="submitTTD()" class="btn btn-danger btn-lg fw-bold rounded-pill shadow py-3">
            <i class="bi bi-check-circle-fill me-2"></i> Setujui & Simpan Tanda Tangan
        </button>
    </div>

</div>

<!-- Form tersembunyi untuk submit -->
<form id="formSubmit" action="/wh/sign/<%= data.kode_unik %>" method="POST" style="display:none;">
    <input type="hidden" name="ttd_data" id="ttdDataInput">
    <input type="hidden" name="nama_penerima" id="namaPenerimaInput">
</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    /* ============================================================
       SETUP CANVAS — proporsional, full-width, fix koordinat
       ============================================================ */
    const wrapper  = document.getElementById('ttdWrapper');
    const canvas   = document.getElementById('signatureCanvas');
    const ctx      = canvas.getContext('2d');
    const placeholder = document.getElementById('ttdPlaceholder');

    function setupCanvas() {
        // Ambil lebar wrapper CSS (display width)
        const cssW = wrapper.clientWidth;
        const cssH = Math.round(cssW * 0.35); // Rasio tinggi 35% dari lebar

        // Set ukuran piksel fisik canvas = ukuran CSS (DPR handling)
        const dpr = window.devicePixelRatio || 1;
        canvas.width  = cssW * dpr;
        canvas.height = cssH * dpr;
        canvas.style.width  = cssW + 'px';
        canvas.style.height = cssH + 'px';

        ctx.scale(dpr, dpr);
        ctx.strokeStyle = '#1a1a2e';
        ctx.lineWidth   = 2.5;
        ctx.lineCap     = 'round';
        ctx.lineJoin    = 'round';
    }

    setupCanvas();
    window.addEventListener('resize', () => { setupCanvas(); hasSigned = false; });

    /* ============================================================
       LOGIKA MENGGAMBAR — koordinat relatif terhadap canvas element
       ============================================================ */
    let drawing  = false;
    let hasSigned = false;

    function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        if (e.touches) {
            return {
                x: e.touches[0].clientX - rect.left,
                y: e.touches[0].clientY - rect.top
            };
        }
        return {
            x: e.clientX - rect.left,
            y: e.clientY - rect.top
        };
    }

    function startDraw(e) {
        e.preventDefault();
        drawing = true;
        const pos = getPos(e);
        ctx.beginPath();
        ctx.moveTo(pos.x, pos.y);

        if (!hasSigned) {
            hasSigned = true;
            placeholder.style.display = 'none';
        }
    }

    function draw(e) {
        if (!drawing) return;
        e.preventDefault();
        const pos = getPos(e);
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();
    }

    function stopDraw(e) {
        if (!drawing) return;
        e.preventDefault();
        drawing = false;
        ctx.closePath();
    }

    // Mouse events
    canvas.addEventListener('mousedown',  startDraw);
    canvas.addEventListener('mousemove',  draw);
    canvas.addEventListener('mouseup',    stopDraw);
    canvas.addEventListener('mouseleave', stopDraw);

    // Touch events (mobile)
    canvas.addEventListener('touchstart', startDraw, { passive: false });
    canvas.addEventListener('touchmove',  draw,      { passive: false });
    canvas.addEventListener('touchend',   stopDraw,  { passive: false });

    /* ============================================================
       AKSI TOMBOL
       ============================================================ */
    function clearCanvas() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        hasSigned = false;
        placeholder.style.display = '';
    }

    function submitTTD() {
        const nama = document.getElementById('namaPenerima').value.trim();

        if (!hasSigned) {
            alert('Harap tanda tangani terlebih dahulu sebelum menyimpan.');
            return;
        }
        if (!nama) {
            alert('Harap isi nama penerima WH.');
            document.getElementById('namaPenerima').focus();
            return;
        }

        // Ambil data canvas sebagai base64 PNG
        const dataURL = canvas.toDataURL('image/png');

        document.getElementById('ttdDataInput').value = dataURL;
        document.getElementById('namaPenerimaInput').value = nama;
        document.getElementById('formSubmit').submit();
    }
</script>
</body>
</html>
