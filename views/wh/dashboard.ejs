<!-- Modal Preview Detail BAST -->
<div class="modal fade" id="modalPreview" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius:18px;border:none;overflow:hidden;">
            <div class="modal-header" style="background:linear-gradient(135deg,var(--navy),#1e4080);color:#fff;">
                <h6 class="modal-title fw-bold"><i class="bi bi-file-earmark-text me-1"></i> Detail BAST</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="previewMeta" class="row g-2 mb-3"></div>
                <div id="previewDevices"></div>
                <div id="previewEviden" class="d-flex flex-wrap gap-2 mt-3"></div>
            </div>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let kodeUnikTarget = '';

    // Fungsi Tolak BAST
    function konfirmasiTolak(kodeUnik) {
        kodeUnikTarget = kodeUnik;
        document.getElementById('kodeUnikTolak').innerText = kodeUnik;
        document.getElementById('alasanTolak').value = '';
        new bootstrap.Modal(document.getElementById('modalTolak')).show();
    }

    function eksekusiTolak() {
        const alasan = document.getElementById('alasanTolak').value.trim();
        if (!alasan) {
            document.getElementById('alasanTolak').style.borderColor = 'var(--red)';
            document.getElementById('alasanTolak').focus();
            setTimeout(() => { document.getElementById('alasanTolak').style.borderColor = 'var(--border)'; }, 1500);
            return;
        }
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/wh/reject/' + kodeUnikTarget;
        const inputAlasan = document.createElement('input');
        inputAlasan.type = 'hidden';
        inputAlasan.name = 'alasan';
        inputAlasan.value = alasan;
        form.appendChild(inputAlasan);
        document.body.appendChild(form);
        form.submit();
    }

    // Set alasan cepat (preset)
    function setAlasan(txt) {
        document.getElementById('alasanTolak').value = txt;
        document.getElementById('alasanTolak').focus();
    }

    // Filter tabel pending
    function filterPendingTable() {
        const kw = (document.getElementById('pendingSearch').value || '').toLowerCase().trim();
        document.querySelectorAll('#tab-pending tbody tr').forEach(tr => {
            tr.style.display = (!kw || tr.textContent.toLowerCase().includes(kw)) ? '' : 'none';
        });
    }

    // Preview detail BAST
    function previewBAST(btn) {
        const kode    = btn.getAttribute('data-kode');
        const tanggal = btn.getAttribute('data-tanggal') || '-';
        const loksto  = btn.getAttribute('data-loksto') || '-';
        const teknisi = btn.getAttribute('data-teknisi') || '-';
        let perangkat = [], eviden = [];
        try { perangkat = JSON.parse(btn.getAttribute('data-perangkat') || '[]'); } catch (e) {}
        try { eviden    = JSON.parse(btn.getAttribute('data-eviden') || '[]'); } catch (e) {}

        document.getElementById('previewMeta').innerHTML =
            '<div class="col-6"><div class="text-muted" style="font-size:.72rem;">Kode BAST</div><div class="fw-bold font-monospace text-danger">' + kode + '</div></div>' +
            '<div class="col-6"><div class="text-muted" style="font-size:.72rem;">Tanggal</div><div class="fw-semibold">' + tanggal + '</div></div>' +
            '<div class="col-6"><div class="text-muted" style="font-size:.72rem;">Lokasi STO</div><div class="fw-semibold">' + loksto + '</div></div>' +
            '<div class="col-6"><div class="text-muted" style="font-size:.72rem;">Teknisi</div><div class="fw-semibold">' + teknisi + '</div></div>';

        let devHtml = '<div class="fw-bold mb-2" style="font-size:.85rem;"><i class="bi bi-router-fill me-1 text-danger"></i>Perangkat (' + perangkat.length + ')</div>';
        if (perangkat.length === 0) {
            devHtml += '<div class="text-muted small">Belum ada perangkat diisi.</div>';
        } else {
            devHtml += '<div class="table-responsive"><table class="table table-sm table-bordered align-middle mb-0" style="font-size:.8rem;">' +
                '<thead style="background:var(--navy);color:#fff;"><tr><th>No</th><th>SN Lama</th><th>SN Baru</th><th>No. Internet</th><th>Kondisi</th></tr></thead><tbody>';
            perangkat.forEach((p, i) => {
                const kond = String(p.kondisi || '').toUpperCase().includes('BAIK') ? 'Baik' : String(p.kondisi || '-');
                devHtml += '<tr><td>' + (i + 1) + '</td><td class="font-monospace">' + (p.snlama || '-') + '</td><td class="font-monospace text-success fw-bold">' + (p.snbaru || '-') + '</td><td class="font-monospace">' + (p.noinet || '-') + '</td><td>' + kond + '</td></tr>';
            });
            devHtml += '</tbody></table></div>';
        }
        document.getElementById('previewDevices').innerHTML = devHtml;

        let evHtml = '';
        if (eviden.length === 0) {
            evHtml = '<div class="text-muted small"><i class="bi bi-image me-1"></i>Tidak ada foto eviden.</div>';
        } else {
            evHtml = eviden.map((f, i) => {
                const clean = '/uploads/eviden/' + String(f).split(/[\\/]/).pop();
                return '<div style="position:relative;"><span class="badge bg-danger" style="position:absolute;top:4px;left:4px;font-size:.62rem;">Foto ' + (i + 1) + '</span>' +
                    '<img src="' + clean + '" style="width:120px;height:90px;object-fit:cover;border-radius:10px;border:1px solid #dde3ec;cursor:pointer;" onclick="window.open(\'' + clean + '\',\'_blank\')" onerror="this.style.opacity=\'0.2\';"></div>';
            }).join('');
        }
        document.getElementById('previewEviden').innerHTML = '<div class="fw-bold w-100 mb-1" style="font-size:.85rem;"><i class="bi bi-images me-1 text-danger"></i>Foto Eviden (' + eviden.length + ')</div>' + evHtml;

        new bootstrap.Modal(document.getElementById('modalPreview')).show();
    }

    // Fungsi Lihat Eviden
    function lihatEviden(btn) {
        const container = document.getElementById('evidenContainer');
        container.innerHTML = '';
        try {
            const arr = JSON.parse(btn.getAttribute('data-eviden') || '[]');
            if (arr.length === 0) {
                container.innerHTML = '<div class="text-white w-100 p-5 text-center">Tidak ada foto eviden yang diunggah.</div>';
            } else {
                arr.forEach((path, i) => {
                    const cleanPath = '/uploads/eviden/' + String(path).split(/[\\/]/).pop();
                    container.innerHTML += `
                        <div class="flex-shrink-0" style="position:relative;">
                            <span class="badge bg-danger position-absolute top-0 start-0 m-2" style="font-size:0.7rem;">Foto ${i+1}</span>
                            <img src="${cleanPath}" class="rounded" style="height:350px; max-width:90vw; object-fit:contain; border:2px solid #1e293b; cursor:pointer;" onclick="window.open(this.src, '_blank')" title="Klik untuk membuka ukuran penuh">
                        </div>
                    `;
                });
            }
            new bootstrap.Modal(document.getElementById('modalEviden')).show();
        } catch(e) {
            alert('Gagal memuat foto eviden');
        }
    }
</script>

<!-- MODAL UBAH PASSWORD -->
<div class="modal fade" id="modalGantiPw" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content" style="border-radius:16px;border:none;">
            <div class="modal-header" style="background:linear-gradient(135deg,#0e1f3b,#1e4080);color:#fff;">
                <h6 class="modal-title fw-bold"><i class="bi bi-shield-lock me-1"></i> Ubah Password</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="pwAlert" class="alert d-none small mb-3"></div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Password Lama</label>
                    <input type="password" class="form-control" id="pwOld" placeholder="Password saat ini">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Password Baru</label>
                    <input type="password" class="form-control" id="pwNew" placeholder="Password baru (min. 4 karakter)">
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold small">Konfirmasi Password Baru</label>
                    <input type="password" class="form-control" id="pwConfirm" placeholder="Ulangi password baru">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                <button type="button" class="btn" id="btnSimpanPw" style="background:#0e1f3b;color:#fff;font-weight:600;" onclick="simpanPassword()">Simpan Password</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openGantiPw() {
        document.getElementById('pwAlert').classList.add('d-none');
        ['pwOld','pwNew','pwConfirm'].forEach(i => document.getElementById(i).value = '');
        new bootstrap.Modal(document.getElementById('modalGantiPw')).show();
    }
    function simpanPassword() {
        const oldp = document.getElementById('pwOld').value;
        const np   = document.getElementById('pwNew').value;
        const cp   = document.getElementById('pwConfirm').value;
        const alertEl = document.getElementById('pwAlert');
        const msg = (t, ok) => { alertEl.className = 'alert small mb-3 ' + (ok ? 'alert-success' : 'alert-danger'); alertEl.textContent = t; };
        if (!oldp) return msg('Masukkan password lama.', false);
        if (!np || np.length < 4) return msg('Password baru minimal 4 karakter.', false);
        if (np !== cp) return msg('Konfirmasi password tidak sama.', false);
        const btn = document.getElementById('btnSimpanPw'); btn.disabled = true;
        fetch('/change-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ old_password: oldp, new_password: np })
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) {
                msg(d.message || 'Password berhasil diubah.', true);
                setTimeout(() => bootstrap.Modal.getInstance(document.getElementById('modalGantiPw')).hide(), 1200);
            } else {
                msg(d.message || 'Gagal mengubah password.', false);
            }
        })
        .catch(() => msg('Kendala koneksi ke server.', false))
        .finally(() => { btn.disabled = false; });
    }
</script>
<script>
    (function () {
        function stagger() {
            document.querySelectorAll('.anim-up').forEach(function (el, i) {
                el.style.animationDelay = (i * 80) + 'ms';
            });
        }
        function countUp(el, target) {
            if (!el) return;
            var dur = 900, start = null;
            function step(now) {
                if (!start) start = now;
                var p = Math.min((now - start) / dur, 1);
                el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
                if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }

        // Umur antrian (hari menunggu)
        function hitungUmur() {
            document.querySelectorAll('.umur-badge').forEach(function (el) {
                var tgl = el.getAttribute('data-tanggal');
                if (!tgl) return;
                var days = Math.floor((Date.now() - new Date(tgl + 'T00:00:00').getTime()) / 86400000);
                if (isNaN(days) || days < 0) days = 0;
                var txt = days === 0 ? 'Hari ini' : days + ' hari';
                var cls = days === 0 ? 'background:#dcfce7;color:#166534;'
                    : days <= 3 ? 'background:#fef9c3;color:#854d0e;'
                    : 'background:#fee2e2;color:#991b1b;';
                el.style.cssText = 'padding:3px 10px;border-radius:999px;font-size:.7rem;font-weight:700;' + cls;
                el.textContent = txt;
            });
        }

        // Pagination generik
        function initPaginasi(containerId, pageSize) {
            var container = document.getElementById(containerId);
            if (!container) return;
            var tbody = container.querySelector('tbody');
            if (!tbody) return;
            var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
            if (rows.length <= pageSize) return;
            var wrap = document.createElement('div');
            wrap.className = 'd-flex justify-content-between align-items-center mt-3 flex-wrap gap-2';
            wrap.innerHTML = '<span class="text-muted small" id="info-' + containerId + '"></span><div class="d-flex flex-wrap gap-1" id="pg-' + containerId + '"></div>';
            container.parentNode.insertBefore(wrap, container.nextSibling);
            var cur = 1;
            function show() {
                var pages = Math.ceil(rows.length / pageSize);
                rows.forEach(function (r, i) { r.style.display = (i >= (cur - 1) * pageSize && i < cur * pageSize) ? '' : 'none'; });
                document.getElementById('info-' + containerId).textContent = rows.length + ' baris';
                var pg = document.getElementById('pg-' + containerId);
                pg.innerHTML = '';
                for (var p = 1; p <= pages; p++) {
                    (function (pp) {
                        var b = document.createElement('button');
                        b.type = 'button';
                        b.className = 'btn btn-sm rounded-pill ' + (pp === cur ? 'btn-dark' : 'btn-light border');
                        b.textContent = pp;
                        b.style.margin = '0 2px';
                        b.onclick = function () { cur = pp; show(); };
                        pg.appendChild(b);
                    })(p);
                }
            }
            show();
        }
        function initCari(containerId, inputId) {
            var input = document.getElementById(inputId);
            var tbody = document.getElementById(containerId) ? document.getElementById(containerId).querySelector('tbody') : null;
            if (!input || !tbody) return;
            input.addEventListener('input', function () {
                var kw = input.value.toLowerCase().trim();
                tbody.querySelectorAll('tr').forEach(function (tr) {
                    tr.style.display = (!kw || tr.textContent.toLowerCase().includes(kw)) ? '' : 'none';
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            stagger();
            document.querySelectorAll('[data-count]').forEach(function (el) {
                countUp(el, parseInt(el.getAttribute('data-count'), 10) || 0);
            });
            hitungUmur();
            initPaginasi('tabelSelesai', 10);
            initPaginasi('tabelDitolak', 10);
            initCari('tabelSelesai', 'selesaiSearch');
            initCari('tabelDitolak', 'ditolakSearch');
        });
    })();
</script>
<script>
    (function () {
        function applyDark(dark) {
            document.body.classList.toggle('dark', dark);
            var btn = document.getElementById('darkToggle');
            if (btn) btn.innerHTML = dark ? '<i class="bi bi-sun-fill"></i>' : '<i class="bi bi-moon-stars-fill"></i>';
            try { localStorage.setItem('bast_dark', dark ? '1' : '0'); } catch (e) {}
        }
        try { applyDark(localStorage.getItem('bast_dark') === '1'); } catch (e) {}
        window.toggleDark = function () { applyDark(!document.body.classList.contains('dark')); };
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function () {});
    })();
</script>
