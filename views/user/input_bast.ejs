<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Input BAST - Telkom Akses</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- SweetAlert2 untuk Pop Up Kode Unik Modern -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #f4f7f6; color: #333; }
        .header-modern { background: linear-gradient(135deg, #EE2E24 0%, #b31217 100%); padding: 2rem 0 4rem 0; border-bottom-left-radius: 40px; border-bottom-right-radius: 40px; color: white; box-shadow: 0 10px 20px rgba(238, 46, 36, 0.2); }
        .form-container { background: #ffffff; border-radius: 20px; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05); margin-top: -40px; padding: 2.5rem; margin-bottom: 3rem; }
        
        .role-btn { border: 2px solid #f0f0f0; border-radius: 16px; transition: all 0.3s ease; background: #fff; color: #6c757d; font-weight: 500; cursor: pointer; }
        .btn-check:checked + .role-btn { border-color: #EE2E24; background: #fff4f4; color: #EE2E24; box-shadow: 0 8px 15px rgba(238, 46, 36, 0.1); transform: translateY(-3px); }
        .role-btn:hover { border-color: #EE2E24; color: #EE2E24; }

        .form-floating > .form-control { border-radius: 12px; border: 1.5px solid #e2e8f0; }
        .form-floating > .form-control:focus { border-color: #EE2E24; box-shadow: 0 0 0 4px rgba(238, 46, 36, 0.1); }
        .section-badge { background: #ffe5e5; color: #EE2E24; padding: 8px 15px; border-radius: 20px; font-weight: 600; font-size: 0.9rem; display: inline-block; margin-bottom: 1.5rem; }
        .ttd-box { border: 2px dashed #cbd5e1; border-radius: 16px; background: #f8fafc; padding: 0; overflow: hidden; transition: 0.3s; }
        .ttd-box:hover { border-color: #EE2E24; background: #fff; }
        .signature-pad { width: 100%; height: 200px; touch-action: none; cursor: crosshair; display: block; }
        .btn-submit { background: #EE2E24; color: white; border-radius: 12px; font-weight: 600; padding: 14px; transition: 0.3s; border:none; width: 100%; }
        .btn-submit:hover { background: #c41230; box-shadow: 0 8px 20px rgba(238, 46, 36, 0.3); transform: translateY(-2px); color: white; }
    </style>
</head>
<body>

<div class="header-modern text-center">
    <div class="container">
        <h3 class="fw-bold"><i class="bi bi-file-earmark-text"></i> Form BAST Digital</h3>
    </div>
</div>

<div class="container">
    <div class="form-container">
        
        <!-- Pilihan Peran -->
        <div class="text-center mb-4">
            <h5 class="fw-bold mb-3">Anda Mengisi Form Ini Sebagai:</h5>
            <div class="row justify-content-center g-3">
                <div class="col-6 col-md-5">
                    <input type="radio" class="btn-check" name="userRole" id="rolePemberi" autocomplete="off" checked onclick="toggleMode('pemberi')">
                    <label class="btn w-100 p-3 role-btn" for="rolePemberi">
                        <i class="bi bi-person-up fs-2 d-block mb-1"></i> Teknisi (Pemberi)
                    </label>
                </div>
                <div class="col-6 col-md-5">
                    <input type="radio" class="btn-check" name="userRole" id="rolePenerima" autocomplete="off" onclick="toggleMode('penerima')">
                    <label class="btn w-100 p-3 role-btn" for="rolePenerima">
                        <i class="bi bi-person-down fs-2 d-block mb-1"></i> Pihak 2 (Penerima)
                    </label>
                </div>
            </div>
        </div>
        <hr class="text-muted opacity-25 mb-4">

        <!-- Bagian Lokasi & STO -->
<div id="areaPemberi">
  <form id="formPemberi" enctype="multipart/form-data">

    <!-- SECTION 1: Lokasi & Waktu -->
    <div class="section-badge"><i class="bi bi-geo-alt-fill me-1"></i> 1. Informasi Lokasi & Waktu</div>
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="form-floating">
          <input type="date" class="form-control" name="tanggal" id="tanggal" required>
          <label for="tanggal">Tanggal Pelaksanaan</label>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-floating">
          <!-- CARI bagian ini di views/user/input/input_bast.ejs dan GANTI: -->
<select class="form-select" name="loksto" id="lokstoSelect" required>
    <option value="" disabled selected>-- Pilih Lokasi STO --</option>
    <% if (typeof stoList !== 'undefined' && stoList.length > 0) { %>
        <% stoList.forEach(s => { %>
            <option value="<%= s.sto %>"><%= s.sto %></option>
        <% }) %>
    <% } else { %>
        <option disabled>Belum ada STO terdaftar</option>
    <% } %>
</select>
          <label for="lokstoSelect">Lokasi / STO</label>
        </div>
      </div>
    </div>

    <!-- SECTION 2: Identitas Teknisi (hanya dropdown, tidak duplikat) -->
    <div class="section-badge"><i class="bi bi-person-badge-fill me-1"></i> 2. Identitas Pihak Pertama (Teknisi)</div>
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="form-floating">
          <select class="form-select" name="teknisi_select" id="teknisiSelect" required>
            <option value="" disabled selected>-- Pilih NIK dan Nama Anda --</option>
            <% if (typeof namaTeknisiList !== 'undefined' && namaTeknisiList.length > 0) { %>
              <% namaTeknisiList.forEach(t => { %>
                <option value="<%= t.nik %> | <%= t.nama %>">
                  <%= t.nik %> — <%= t.nama %>
                </option>
              <% }) %>
            <% } else { %>
              <option disabled>Belum ada teknisi terdaftar</option>
            <% } %>
          </select>
          <label for="teknisiSelect">Pilih Nama Teknisi</label>
        </div>
      </div>
      <div class="col-md-3">
        <div class="form-floating">
          <input type="text" class="form-control bg-light" id="displayJabatan" value="Teknisi" readonly>
          <label>Jabatan</label>
        </div>
      </div>
      <div class="col-md-3">
        <div class="form-floating">
          <input type="text" class="form-control bg-light" id="displayInstansi" value="PT. TELKOM AKSES" readonly>
          <label>Instansi</label>
        </div>
      </div>
    </div>

    <!-- SECTION 3: Data Perangkat (dengan tombol tambah baris) -->
    <div class="section-badge"><i class="bi bi-router-fill me-1"></i> 3. Data Perangkat & Eviden</div>
    <div id="perangkatContainer">
      <div class="row g-3 mb-2 perangkat-row align-items-center">
        <div class="col-md-3">
          <div class="form-floating">
            <input type="text" class="form-control" name="snlama[]" placeholder="SN Lama" required>
            <label>SN Lama</label>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-floating">
            <input type="text" class="form-control" name="snbaru[]" placeholder="SN Baru" required>
            <label>SN Baru</label>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-floating">
            <input type="text" class="form-control" name="noinet[]" placeholder="No Inet">
            <label>Nomor Internet</label>
          </div>
        </div>
        <div class="col-md-2">
          <div class="form-floating">
            <select class="form-select" name="kondisi[]">
              <option value="Baik">Baik</option>
              <option value="Rusak">Rusak</option>
              <option value="Hilang">Hilang</option>
            </select>
            <label>Kondisi</label>
          </div>
        </div>
        <div class="col-md-1 text-center">
          <button type="button" class="btn btn-outline-danger btn-sm rounded-circle" onclick="hapusRow(this)" title="Hapus baris">
            <i class="bi bi-dash-lg"></i>
          </button>
        </div>
      </div>
    </div>
    <button type="button" class="btn btn-outline-success btn-sm rounded-pill mb-4 px-4" onclick="tambahBaris()">
      <i class="bi bi-plus-lg me-1"></i> Tambah Baris Perangkat
    </button>

    <!-- Upload Eviden -->
    <div class="mb-4">
      <label class="form-label fw-semibold small">Upload Foto Eviden Lapangan</label>
      <input type="file" name="eviden" class="form-control" accept="image/*" multiple>
    </div>

    <!-- TTD Teknisi -->
    <div class="section-badge"><i class="bi bi-pen-fill me-1"></i> 4. Tanda Tangan Teknisi</div>
    <div class="row mb-4 justify-content-center">
      <div class="col-md-8 text-center">
        <div class="ttd-box">
          <canvas id="canvasPemberi" class="signature-pad"></canvas>
        </div>
        <button type="button" class="btn btn-sm btn-light text-danger mt-2 rounded-pill shadow-sm"
          onclick="clearCanvas(canvasPemberi, ctxPemberi)">
          <i class="bi bi-eraser-fill"></i> Hapus Coretan
        </button>
      </div>
    </div>

    <button type="button" class="btn-submit" onclick="submitPemberi()" id="btnSubmitPemberi">
      <i class="bi bi-cloud-upload-fill me-2"></i> SIMPAN & BUAT KODE UNIK
    </button>

  </form>
</div>
        <!-- ============================================== -->
        <!-- AREA 2: FORM PENERIMA (PIHAK 2)                -->
        <!-- ============================================== -->
        <div id="areaPenerima" style="display: none;">
            
            <!-- Pencarian Kode -->
            <div class="card bg-light border-0 rounded-4 p-4 mb-4 text-center">
                <h5 class="fw-bold mb-3 text-danger"><i class="bi bi-key-fill"></i> Masukkan Kode Unik</h5>
                <p class="text-muted small">Minta Kode Unik BAST kepada Teknisi yang bertugas.</p>
                <div class="input-group mb-3" style="max-width: 400px; margin: 0 auto;">
                    <input type="text" class="form-control form-control-lg text-center fw-bold" id="inputKodeUnik" placeholder="Contoh: BAST-XXXXX" style="text-transform: uppercase;">
                    <button class="btn btn-danger px-4" type="button" onclick="cekKode()">CEK</button>
                </div>
            </div>

            <!-- Form Identitas Penerima (Disembunyikan sebelum kode benar) -->
            <form id="formPenerima" style="display: none;" action="/user/submit-penerima" method="POST">
                <input type="hidden" name="kode_unik" id="hiddenKodeUnik">
                
                <div class="section-badge"><i class="bi bi-person-fill-add me-1"></i> Identitas Penerima</div>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="form-floating"><input type="text" class="form-control" name="namapenerima" placeholder="Nama" required><label>Nama Penerima</label></div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating"><input type="text" class="form-control" name="nikpenerima" placeholder="NIK" required><label>NIK Penerima</label></div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating"><input type="text" class="form-control" name="instansipenerima" value="PT. TELKOM AKSES" required><label>Instansi / Alamat</label></div>
                    </div>
                </div>

                <div class="section-badge"><i class="bi bi-pen-fill me-1"></i> Tanda Tangan Penerima</div>
                <div class="row mb-5 justify-content-center">
                    <div class="col-md-8 text-center">
                        <div class="ttd-box"><canvas id="canvasPenerima" class="signature-pad"></canvas></div>
                        <button type="button" class="btn btn-sm btn-light text-danger mt-2 rounded-pill shadow-sm" onclick="clearCanvas(canvasPenerima, ctxPenerima)"><i class="bi bi-eraser-fill"></i> Hapus Coretan</button>
                        <input type="hidden" name="ttdPenerimaBase64" id="ttdPenerimaBase64">
                    </div>
                </div>

                <button type="button" class="btn-submit" onclick="submitPenerima()">
                    <i class="bi bi-printer-fill me-2"></i> SELESAIKAN & CETAK BAST
                </button>
            </form>
        </div>

    </div>
</div>

<script>
    // Logic Menyembunyikan / Menampilkan Area Berdasarkan Pilihan
    function toggleMode(mode) {
        document.getElementById('areaPemberi').style.display = (mode === 'pemberi') ? 'block' : 'none';
        document.getElementById('areaPenerima').style.display = (mode === 'penerima') ? 'block' : 'none';
    }

    // Inisialisasi Canvas TTD
    function setupCanvas(canvasId) {
    const canvas = document.getElementById(canvasId);
    const ctx = canvas.getContext('2d');
    ctx.lineWidth = 3; ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.strokeStyle = '#1e293b'; 
    let drawing = false;

    function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        // Hitung scale jika canvas CSS size berbeda dengan pixel size
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        
        if (e.touches) {
            return {
                x: (e.touches[0].clientX - rect.left) * scaleX,
                y: (e.touches[0].clientY - rect.top) * scaleY
            };
        }
        return {
            x: (e.clientX - rect.left) * scaleX,
            y: (e.clientY - rect.top) * scaleY
        };
    }

    const startDraw = (e) => { 
        e.preventDefault();
        drawing = true; 
        const pos = getPos(e);
        ctx.beginPath(); 
        ctx.moveTo(pos.x, pos.y); 
    };
    
    const draw = (e) => { 
        if (!drawing) return;
        e.preventDefault(); 
        const pos = getPos(e);
        ctx.lineTo(pos.x, pos.y); 
        ctx.stroke(); 
    };
    
    const stopDraw = (e) => { 
        drawing = false; 
        ctx.beginPath(); // reset path agar tidak nyambung ke goresan berikutnya
    };

    // Set ukuran canvas sesuai tampilan agar tidak stretch
    function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        canvas.width = rect.width;
        canvas.height = rect.height || 200;
        ctx.lineWidth = 3; ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.strokeStyle = '#1e293b';
    }
    resizeCanvas();

    canvas.addEventListener('mousedown', startDraw); 
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDraw); 
    canvas.addEventListener('mouseleave', stopDraw);
    canvas.addEventListener('touchstart', startDraw, { passive: false }); 
    canvas.addEventListener('touchmove', draw, { passive: false });
    canvas.addEventListener('touchend', stopDraw);
    
    return { canvas, ctx };
}

    // --- PROSES 1: PEMBERI (TEKNISI) ---
    async function submitPemberi() {
        const btn = document.getElementById('btnSubmitPemberi');
        const form = document.getElementById('formPemberi');
        if(!form.checkValidity()) { form.reportValidity(); return; } // Cek validasi wajib isi

        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Memproses...';
        btn.disabled = true;

        const formData = new FormData(form);
        formData.append('ttdPemberiBase64', canvasPemberi.toDataURL()); // Masukkan gambar TTD

        try {
            const response = await fetch('/user/submit-pemberi', { method: 'POST', body: formData });
            const result = await response.json();
            
            if (result.success) {
                // Munculkan Pop-Up sukses dengan KODE UNIK
                Swal.fire({
                    icon: 'success',
                    title: 'Form Tersimpan!',
                    html: `Berikan Kode Unik ini kepada Penerima:<br><br><b style="font-size: 30px; color: #EE2E24; letter-spacing: 2px;">${result.kodeUnik}</b>`,
                    confirmButtonText: 'Selesai',
                    confirmButtonColor: '#EE2E24',
                    allowOutsideClick: false
                }).then(() => { window.location.reload(); });
            }
        } catch (error) {
            Swal.fire('Error', 'Terjadi kesalahan sistem.', 'error');
            btn.disabled = false; btn.innerHTML = '<i class="bi bi-cloud-upload-fill me-2"></i> SIMPAN & BUAT KODE UNIK';
        }
    }

    // --- PROSES 2: CEK KODE OLEH PENERIMA ---
    async function cekKode() {
        const kode = document.getElementById('inputKodeUnik').value.trim().toUpperCase();
        if (!kode) return Swal.fire('Perhatian', 'Masukkan kode unik terlebih dahulu!', 'warning');

        try {
            const response = await fetch(`/api/cek-kode/${kode}`);
            const result = await response.json();

            if (result.success) {
                Swal.fire('Ditemukan!', `Silakan isi identitas Anda untuk menyelesaikan serah terima dari Teknisi: <b>${result.data.namapemberi}</b>`, 'success');
                document.getElementById('hiddenKodeUnik').value = kode;
                document.getElementById('formPenerima').style.display = 'block'; // Tampilkan form penerima
                
                // Scroll perlahan ke bawah form penerima
                setTimeout(() => document.getElementById('formPenerima').scrollIntoView({ behavior: 'smooth' }), 500);
            } else {
                Swal.fire('Gagal', result.message, 'error');
                document.getElementById('formPenerima').style.display = 'none';
            }
        } catch (error) {
            Swal.fire('Error', 'Gagal mengecek kode.', 'error');
        }
    }

    // --- PROSES 3: SUBMIT PENERIMA ---
    function submitPenerima() {
        const form = document.getElementById('formPenerima');
        if(!form.checkValidity()) { form.reportValidity(); return; }

        document.getElementById('ttdPenerimaBase64').value = canvasPenerima.toDataURL();
        
        const btn = document.querySelector('#formPenerima .btn-submit');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Mengenerate Dokumen...';
        btn.style.opacity = '0.8'; btn.style.pointerEvents = 'none';
        
        form.submit();
    }
</script>
 <!-- Script tambah/hapus baris perangkat -->
    <script>
    function tambahBaris() {
      const container = document.getElementById('perangkatContainer');
      const baris = `
        <div class="row g-3 mb-2 perangkat-row align-items-center">
          <div class="col-md-3"><div class="form-floating">
            <input type="text" class="form-control" name="snlama[]" placeholder="SN Lama" required>
            <label>SN Lama</label></div></div>
          <div class="col-md-3"><div class="form-floating">
            <input type="text" class="form-control" name="snbaru[]" placeholder="SN Baru" required>
            <label>SN Baru</label></div></div>
          <div class="col-md-3"><div class="form-floating">
            <input type="text" class="form-control" name="noinet[]" placeholder="No Inet">
            <label>Nomor Internet</label></div></div>
          <div class="col-md-2"><div class="form-floating">
            <select class="form-select" name="kondisi[]">
              <option value="Baik">Baik</option>
              <option value="Rusak">Rusak</option>
              <option value="Hilang">Hilang</option>
            </select>
            <label>Kondisi</label></div></div>
          <div class="col-md-1 text-center">
            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle"
              onclick="hapusRow(this)"><i class="bi bi-dash-lg"></i></button>
          </div>
        </div>`;
      container.insertAdjacentHTML('beforeend', baris);
    }

    function hapusRow(btn) {
      const rows = document.querySelectorAll('.perangkat-row');
      if (rows.length > 1) btn.closest('.perangkat-row').remove();
    }
    </script>
</body>
</html>