<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Input BAST - Teknisi | Telkom Akses</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --navy:  #0e1f3b;
            --navy2: #162d52;
            --red:   #EE2E24;
            --red2:  #c42019;
            --gold:  #f59e0b;
            --surface:#f0f4f8;
            --border: #dde3ec;
            --text:   #1e293b;
            --muted:  #64748b;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Poppins', sans-serif;
            background: var(--surface);
            color: var(--text);
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Blob dekoratif latar */
        .bg-deco { position: fixed; border-radius: 50%; filter: blur(60px); opacity: .16; pointer-events: none; z-index: 0; }
        .bg-deco.d1 { width: 380px; height: 380px; top: -90px; right: -70px; background: var(--red); animation: floatBlob 12s ease-in-out infinite; }
        .bg-deco.d2 { width: 300px; height: 300px; bottom: -80px; left: -70px; background: var(--navy); animation: floatBlob 14s ease-in-out 2.2s infinite; }

        /* ===== HEADER ===== */
        .header-modern {
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(900px 500px at 85% -20%, rgba(238,46,36,.35), transparent 60%),
                radial-gradient(700px 400px at -10% 120%, rgba(245,158,11,.16), transparent 60%),
                linear-gradient(150deg, var(--navy) 0%, #12264a 50%, var(--navy2) 100%);
            border-bottom: 3px solid var(--red);
            padding: 1.6rem 0 3.2rem;
            color: #fff;
        }
        .header-modern::before, .header-modern::after {
            content: ''; position: absolute; border-radius: 50%;
            background: rgba(255,255,255,.07); pointer-events: none;
        }
        .header-modern::before { width: 240px; height: 240px; top: -110px; right: -40px; animation: floatCircle 10s ease-in-out infinite; }
        .header-modern::after  { width: 150px; height: 150px; bottom: -60px; left: -30px; animation: floatCircle 12s ease-in-out 1.6s infinite; }
        .header-modern .container { position: relative; z-index: 1; }
        @keyframes floatCircle { 0%, 100% { transform: translate(0,0); } 50% { transform: translate(20px,16px); } }

        .header-top {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 1.6rem;
        }
        .brand-logo {
            background: var(--red); color: #fff;
            font-weight: 800; letter-spacing: 1px;
            padding: 8px 16px; border-radius: 10px;
            font-size: .9rem; box-shadow: 0 8px 20px rgba(238,46,36,.35);
        }
        .header-title { font-weight: 800; letter-spacing: .3px; }
        .header-sub { opacity: .72; font-weight: 300; font-size: .92rem; }
        .header-sub i { color: var(--gold); }

        /* ===== FORM CARD ===== */
        .form-container {
            position: relative; z-index: 1;
            background: #fff;
            border-radius: 22px;
            border: 1px solid var(--border);
            box-shadow: 0 24px 60px rgba(14,31,59,.12);
            margin-top: -34px;
            padding: 2.4rem 2.2rem;
            margin-bottom: 3rem;
        }

        /* ===== SECTION BADGE ===== */
        .section-badge {
            display: inline-flex; align-items: center; gap: 10px;
            background: #fff1f1; color: var(--red);
            border: 1px solid #ffd7d7;
            padding: 8px 18px 8px 8px; border-radius: 999px;
            font-weight: 700; font-size: .9rem;
            margin-bottom: 1.4rem;
        }
        .section-badge .num {
            width: 27px; height: 27px; border-radius: 50%;
            background: var(--red); color: #fff;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: .82rem; font-weight: 800; flex-shrink: 0;
        }
        .section-badge.dark { background: #eef2f8; color: var(--navy); border-color: #d7e0ee; }
        .section-badge.dark .num { background: var(--navy); }

        /* ===== FORM FIELD ===== */
        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid var(--border);
            font-size: .9rem;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--red);
            box-shadow: 0 0 0 4px rgba(238,46,36,.1);
        }
        .form-label { font-weight: 600; font-size: .82rem; color: #475569; }

        /* ===== TABLE PERANGKAT ===== */
        .table-perangkat th {
            background: var(--navy); color: rgba(255,255,255,.88);
            font-size: .72rem; text-transform: uppercase; letter-spacing: .5px;
            border: none !important; font-weight: 600;
        }
        .table-perangkat td { vertical-align: middle; }
        .table-perangkat tbody tr { transition: background .2s, transform .15s; }
        .table-perangkat tbody tr:hover { background: #fafbff; transform: translateX(2px); }

        /* ===== UPLOAD EVIDEN ===== */
        .upload-eviden {
            border: 2px dashed var(--border); border-radius: 14px;
            background: #f8fafc; padding: 1.2rem 1.4rem;
            transition: border-color .25s, background .25s, box-shadow .25s;
        }
        .upload-eviden:hover, .upload-eviden.active {
            border-color: var(--red); background: #fff5f5;
            box-shadow: 0 0 0 4px rgba(238,46,36,.06);
        }

        /* ===== TANDA TANGAN ===== */
        .ttd-box {
            position: relative;
            border: 2px dashed #c7d2fe;
            border-radius: 16px;
            background: #fafbff;
            overflow: hidden;
            cursor: crosshair;
            transition: border-color .25s, box-shadow .25s, background .25s;
        }
        .ttd-box:hover, .ttd-box.active {
            border-color: var(--red); background: #fff;
            box-shadow: 0 0 0 4px rgba(238,46,36,.08);
        }
        #canvasPemberi { display: block; width: 100%; height: 200px; touch-action: none; cursor: crosshair; }
        .ttd-placeholder {
            position: absolute; inset: 0;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            color: #c7d2fe; font-size: .85rem; pointer-events: none; text-align: center;
        }
        .ttd-placeholder i { font-size: 2.4rem; margin-bottom: 8px; }

        /* ===== TOMBOL SUBMIT ===== */
        .btn-submit {
            background: linear-gradient(135deg, var(--red) 0%, var(--red2) 100%);
            color: #fff; border: none; border-radius: 14px;
            font-weight: 700; font-size: 1rem; padding: 15px; width: 100%;
            box-shadow: 0 10px 26px rgba(238,46,36,.32);
            cursor: pointer;
            transition: transform .2s, box-shadow .2s, filter .2s;
            animation: pulseCta 2.6s ease-in-out infinite;
        }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 16px 34px rgba(238,46,36,.42); }
        .btn-submit:active { transform: translateY(0); }
        .btn-submit:disabled { opacity: .85; cursor: progress; filter: saturate(.7); animation: none; }
        @keyframes pulseCta { 0%, 100% { box-shadow: 0 10px 26px rgba(238,46,36,.32); } 50% { box-shadow: 0 10px 36px rgba(238,46,36,.55); } }

        .btn-sm { transition: transform .15s; }
        .btn-sm:hover { transform: translateY(-1px); }

        /* ===== ANIMASI MASUK ===== */
        @keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes floatBlob { 0%, 100% { transform: translate(0,0) scale(1); } 50% { transform: translate(26px,-22px) scale(1.07); } }
        .anim-up { opacity: 0; animation: fadeUp .6s cubic-bezier(.22,1,.36,1) both; }

        /* ===== STEP INDICATOR ===== */
        .step-pill {
            display: inline-flex; align-items: center; gap: 6px;
            background: #eef2f8; color: var(--muted);
            border: 1px solid var(--border); border-radius: 999px;
            padding: 6px 14px; font-size: .74rem; font-weight: 600;
        }
        .step-pill .n {
            width: 20px; height: 20px; border-radius: 50%;
            background: #cbd5e1; color: #fff;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: .7rem; font-weight: 800;
        }
        .step-pill.active { background: #fff1f1; color: var(--red); border-color: #ffd7d7; }
        .step-pill.active .n { background: var(--red); }

        @media (prefers-reduced-motion: reduce) {
            .anim-up, .bg-deco, .header-modern::before, .header-modern::after, .btn-submit { animation: none !important; transition: none !important; }
            .anim-up { opacity: 1; }
            .bg-deco { display: none; }
        }
    </style>
</head>
<body>

<div class="bg-deco d1"></div>
<div class="bg-deco d2"></div>

<!-- HEADER -->
<div class="header-modern">
    <div class="container">
        <div class="header-top anim-up">
            <a href="/teknisi/dashboard" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Dasbor
            </a>
            <div class="d-flex align-items-center gap-2">
                <span class="brand-logo">BAST</span>
                <span class="fw-semibold" style="font-size:.9rem;">TELKOM AKSES</span>
            </div>
        </div>
        <div class="text-center">
            <h3 class="header-title anim-up"><i class="bi bi-file-earmark-text me-2"></i>Form Serah Terima Teknisi</h3>
            <p class="header-sub mb-0 anim-up"><i class="bi bi-box-seam-fill me-1"></i> Isi data perangkat yang akan diserahkan ke Warehouse</p>
        </div>
    </div>
</div>

<div class="container">
    <div class="form-container">
        <form id="formTeknisi">

            <!-- Indikator langkah -->
            <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap anim-up">
                <span class="step-pill"><span class="n">1</span> Lokasi</span>
                <span class="step-pill"><span class="n">2</span> Teknisi</span>
                <span class="step-pill"><span class="n">3</span> Perangkat</span>
                <span class="step-pill"><span class="n">4</span> Foto</span>
                <span class="step-pill"><span class="n">5</span> Tanda Tangan</span>
            </div>

            <!-- 1. Lokasi & Waktu -->
            <div class="section-badge anim-up"><span class="num">1</span> <i class="bi bi-geo-alt-fill"></i> Informasi Lokasi &amp; Waktu</div>
            <div class="row mb-4">
                <div class="col-md-6 mb-3 anim-up">
                    <label class="form-label">Tanggal Pelaksanaan</label>
                    <input type="date" class="form-control" name="tanggal" required>
                </div>
                <div class="col-md-6 mb-3 anim-up">
                    <label class="form-label">Lokasi / STO</label>
                    <select class="form-select" name="loksto" id="lokstoSelect" required>
                        <option value="" disabled selected>-- Pilih Lokasi STO --</option>
                        <% if (typeof stoList !== 'undefined' && stoList.length > 0) { %>
                            <% stoList.forEach(s => { %>
                                <option value="<%= s.sto %>"><%= s.sto %></option>
                            <% }) %>
                        <% } else { %>
                            <option disabled>Belum ada STO terdaftar</option>
                        <% } %>
                    </select>
                </div>
            </div>

            <!-- 2. Identitas Teknisi -->
            <div class="section-badge anim-up"><span class="num">2</span> <i class="bi bi-person-vcard-fill"></i> Identitas Pihak Pertama (Teknisi)</div>
            <div class="mb-4 anim-up">
                <label class="form-label">Pilih Nama Teknisi</label>
                <select class="form-select" name="teknisi_select" required>
                    <option value="" selected disabled>-- Pilih NIK dan Nama Anda --</option>
                    <% namaTeknisiList.forEach(t => { %>
                    <option value="<%= t.nik %> | <%= t.nama %>">
                        <%= t.nik %> | <%= t.nama %>
                    </option>
                    <% }) %>
                </select>
            </div>

            <!-- 3. Multi Input Perangkat -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 anim-up">
                <div class="section-badge dark mb-0"><span class="num">3</span> <i class="bi bi-router-fill"></i> Data Perangkat ONT</div>
                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold" onclick="tambahBaris()">
                    <i class="bi bi-plus-circle me-1"></i> Tambah (Max 10)
                </button>
            </div>

            <div class="table-responsive mb-4 anim-up">
                <table class="table table-bordered table-perangkat align-middle" id="tabelPerangkat">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:44px;">No</th>
                            <th>Merk &amp; SN Lama</th>
                            <th>Merk &amp; SN Baru</th>
                            <th>No Internet</th>
                            <th>Kondisi</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="bodyPerangkat">
                        <!-- Baris Pertama (Default) -->
                        <tr>
                            <td class="text-center baris-nomor fw-bold text-muted">1</td>
                            <td><input type="text" class="form-control form-control-sm" name="snlama" placeholder="SN Lama" required></td>
                            <td><input type="text" class="form-control form-control-sm" name="snbaru" placeholder="SN Baru" required></td>
                            <td><input type="text" class="form-control form-control-sm" name="noinet" placeholder="No Inet" required></td>
                            <td>
                                <select class="form-select form-select-sm" name="kondisi" required>
                                    <option value="Baik">Baik</option>
                                    <option value="Rusak">Rusak</option>
                                </select>
                            </td>
                            <td class="text-center text-muted">—</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- 4. Upload Eviden -->
            <div class="section-badge anim-up"><span class="num">4</span> <i class="bi bi-camera-fill"></i> Upload Eviden Lapangan</div>
            <div class="upload-eviden mb-4 anim-up" id="uploadEvidenBox">
                <label class="form-label fw-bold" for="inputFoto">
                    <i class="bi bi-image me-1 text-danger"></i> Pilih Foto (bisa lebih dari satu, maksimal 10 foto)
                </label>
                <input type="file" class="form-control" name="eviden" id="inputFoto" accept="image/*" multiple required onchange="cekJumlahFoto()">
                <small class="text-danger fw-bold mt-2 d-block">
                    <i class="bi bi-exclamation-triangle-fill"></i> INFO: Foto barcode dan SN harus terlihat jelas!
                </small>
            </div>

            <!-- 5. TTD -->
            <div class="section-badge anim-up"><span class="num">5</span> <i class="bi bi-pen-fill"></i> Tanda Tangan Anda</div>
            <div class="mb-5 text-center anim-up">
                <div class="ttd-box" id="ttdBox">
                    <canvas id="canvasPemberi"></canvas>
                    <div class="ttd-placeholder" id="ttdPlaceholder">
                        <i class="bi bi-pen"></i>
                        Tanda tangan di sini
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger mt-2 rounded-pill px-4 fw-semibold" onclick="clearCanvas()">
                    <i class="bi bi-eraser-fill me-1"></i> Hapus Coretan
                </button>
            </div>

            <button type="button" class="btn-submit anim-up" onclick="submitForm()" id="btnSubmit">
                <i class="bi bi-cloud-arrow-up-fill me-2"></i> SIMPAN &amp; BUAT KODE BAST
            </button>
        </form>
    </div>
</div>

<script>
    // Logic Multi-Baris Perangkat (Maks 10)
    let jmlBaris = 1;
    function tambahBaris() {
        if (jmlBaris >= 10) return Swal.fire('Batas Maksimal', 'Anda hanya bisa input maksimal 10 perangkat sekaligus.', 'warning');

        jmlBaris++;
        const tbody = document.getElementById('bodyPerangkat');
        const tr = document.createElement('tr');
        tr.classList.add('baris-baru');
        tr.style.opacity = '0';
        tr.innerHTML = `
            <td class="text-center baris-nomor fw-bold text-muted">${jmlBaris}</td>
            <td><input type="text" class="form-control form-control-sm" name="snlama" placeholder="SN Lama" required></td>
            <td><input type="text" class="form-control form-control-sm" name="snbaru" placeholder="SN Baru" required></td>
            <td><input type="text" class="form-control form-control-sm" name="noinet" placeholder="No Inet" required></td>
            <td>
                <select class="form-select form-select-sm" name="kondisi" required>
                    <option value="Baik">Baik</option>
                    <option value="Rusak">Rusak</option>
                </select>
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger rounded-circle" onclick="hapusBaris(this)" title="Hapus baris">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);
        requestAnimationFrame(() => { tr.style.transition = 'opacity .3s ease'; tr.style.opacity = '1'; });
        updateNomor();
    }

    function hapusBaris(btn) {
        btn.closest('tr').remove();
        jmlBaris--;
        updateNomor();
    }

    function updateNomor() {
        const baris = document.querySelectorAll('.baris-nomor');
        baris.forEach((td, index) => td.innerText = index + 1);
    }

    // Logic Validasi Jumlah Foto Maksimal 10
    function cekJumlahFoto() {
        const input = document.getElementById('inputFoto');
        const box   = document.getElementById('uploadEvidenBox');
        if (input.files.length > 10) {
            Swal.fire('Terlalu Banyak!', 'Maksimal upload 10 foto.', 'error');
            input.value = '';
            box.classList.remove('active');
        } else if (input.files.length > 0) {
            box.classList.add('active');
        } else {
            box.classList.remove('active');
        }
    }

    // Canvas Tanda Tangan
    const canvas = document.getElementById('canvasPemberi');
    const ctx = canvas.getContext('2d');
    const ttdBox = document.getElementById('ttdBox');
    const ttdPlaceholder = document.getElementById('ttdPlaceholder');
    let drawing = false, hasSigned = false;
    ctx.lineWidth = 3; ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.strokeStyle = '#0e1f3b';

    // Sesuaikan ukuran pixel canvas dengan tampilan CSS
    function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height || 200;
        ctx.lineWidth = 3; ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.strokeStyle = '#0e1f3b';
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        if (e.touches) {
            return {
                x: (e.touches[0].clientX - rect.left) * scaleX,
                y: (e.touches[0].clientY - rect.top) * scaleY
            };
        }
        return {
            x: (e.clientX - rect.left) * scaleX,
            y: (e.clientY - rect.top) * scaleY
        };
    }

    const startDraw = (e) => {
        e.preventDefault();
        drawing = true;
        if (!hasSigned) {
            hasSigned = true;
            ttdPlaceholder.style.display = 'none';
            ttdBox.classList.add('active');
        }
        const pos = getPos(e);
        ctx.beginPath();
        ctx.moveTo(pos.x, pos.y);
    };

    const draw = (e) => {
        if (!drawing) return;
        e.preventDefault();
        const pos = getPos(e);
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();
    };

    const stopDraw = () => {
        drawing = false;
        ctx.beginPath();
    };

    canvas.addEventListener('mousedown', startDraw);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDraw);
    canvas.addEventListener('mouseleave', stopDraw);
    canvas.addEventListener('touchstart', startDraw, { passive: false });
    canvas.addEventListener('touchmove', draw, { passive: false });
    canvas.addEventListener('touchend', stopDraw);

    function clearCanvas() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        hasSigned = false;
        ttdPlaceholder.style.display = '';
        ttdBox.classList.remove('active');
    }

    // Proses Submit (Kirim Data ke Server)
    // Cek SN duplikat antar baris
    function cekDuplikatSN() {
        const seen = {};
        let dup = false;
        document.querySelectorAll('#bodyPerangkat input[name="snlama"]').forEach(function (inp) {
            const v = inp.value.trim().toUpperCase();
            inp.style.borderColor = '';
            if (!v) return;
            if (seen[v]) { inp.style.borderColor = 'var(--red)'; dup = true; }
            else { seen[v] = 1; }
        });
        if (dup) {
            Swal.fire('Duplikat SN', 'Ada SN Lama yang sama di lebih dari satu baris. Mohon periksa kembali.', 'warning');
            return false;
        }
        return true;
    }

    // Kompresi foto sebelum upload (mengurangi ukuran file)
    function compressImage(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = (ev) => {
                const img = new Image();
                img.onload = () => {
                    const MAX = 1200;
                    let w = img.width, h = img.height;
                    if (w > MAX || h > MAX) { const r = Math.min(MAX / w, MAX / h); w = Math.round(w * r); h = Math.round(h * r); }
                    const c = document.createElement('canvas');
                    c.width = w; c.height = h;
                    c.getContext('2d').drawImage(img, 0, 0, w, h);
                    c.toBlob((blob) => resolve(blob ? new File([blob], file.name, { type: 'image/jpeg' }) : file), 'image/jpeg', 0.82);
                };
                img.onerror = () => resolve(file);
                img.src = ev.target.result;
            };
            reader.onerror = () => resolve(file);
            reader.readAsDataURL(file);
        });
    }

    // ===== Auto-save draft (localStorage) =====
    const DRAFT_KEY = 'bast_draft';
    function saveDraft() {
        const data = {
            tanggal: (document.querySelector('[name="tanggal"]') || {}).value || '',
            loksto: (document.querySelector('[name="loksto"]') || {}).value || '',
            teknisi: (document.querySelector('[name="teknisi_select"]') || {}).value || '',
            rows: []
        };
        document.querySelectorAll('#bodyPerangkat tr').forEach(tr => {
            const g = (sel) => { const el = tr.querySelector(sel); return el ? el.value : ''; };
            data.rows.push({ snlama: g('[name=snlama]'), snbaru: g('[name=snbaru]'), noinet: g('[name=noinet]'), kondisi: g('[name=kondisi]') });
        });
        try { localStorage.setItem(DRAFT_KEY, JSON.stringify(data)); } catch (e) {}
    }
    let draftTimer = null;
    function scheduleSaveDraft() {
        clearTimeout(draftTimer);
        draftTimer = setTimeout(saveDraft, 800);
    }
    function loadDraft() {
        try {
            const d = JSON.parse(localStorage.getItem(DRAFT_KEY));
            if (!d || !d.rows || d.rows.length === 0) return;
            const setv = (sel, v) => { const el = document.querySelector(sel); if (el) el.value = v || ''; };
            setv('[name="tanggal"]', d.tanggal);
            setv('[name="loksto"]', d.loksto);
            setv('[name="teknisi_select"]', d.teknisi);
            const tbody = document.getElementById('bodyPerangkat');
            const first = tbody.querySelector('tr');
            const fill = (tr, r) => {
                const g = (sel) => tr.querySelector(sel);
                if (g('[name=snlama]')) g('[name=snlama]').value = r.snlama || '';
                if (g('[name=snbaru]')) g('[name=snbaru]').value = r.snbaru || '';
                if (g('[name=noinet]')) g('[name=noinet]').value = r.noinet || '';
                if (g('[name=kondisi]')) g('[name=kondisi]').value = r.kondisi || 'Baik';
            };
            fill(first, d.rows[0]);
            for (let i = 1; i < d.rows.length; i++) {
                tambahBaris();
                const trs = tbody.querySelectorAll('tr');
                fill(trs[trs.length - 1], d.rows[i]);
            }
        } catch (e) {}
    }
    function clearDraft() { try { localStorage.removeItem(DRAFT_KEY); } catch (e) {} }
    document.addEventListener('input', scheduleSaveDraft);

    async function submitForm() {
        const form = document.getElementById('formTeknisi');
        if (!form.checkValidity()) return form.reportValidity(); // Cek inputan kosong
        if (!cekDuplikatSN()) return;

        const btn = document.getElementById('btnSubmit');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Mengirim Data...';
        btn.disabled = true;

        const formData = new FormData();
        const el = (n) => form.elements[n] ? form.elements[n].value : '';
        formData.append('tanggal', el('tanggal'));
        formData.append('loksto', el('loksto'));
        formData.append('teknisi_select', el('teknisi_select'));
        document.querySelectorAll('#bodyPerangkat tr').forEach(tr => {
            const g = (sel) => { const x = tr.querySelector(sel); return x ? x.value : ''; };
            formData.append('snlama', g('[name=snlama]'));
            formData.append('snbaru', g('[name=snbaru]'));
            formData.append('noinet', g('[name=noinet]'));
            formData.append('kondisi', g('[name=kondisi]'));
        });
        const files = document.getElementById('inputFoto').files;
        if (files.length) {
            for (let i = 0; i < files.length; i++) formData.append('eviden', await compressImage(files[i]));
        }
        formData.append('ttdPemberiBase64', canvas.toDataURL());

        try {
            const response = await fetch('/teknisi/submit', { method: 'POST', body: formData });

            // Cek jika server mengalami error fatal
            if (!response.ok) {
                const errText = await response.text();
                throw new Error('Gagal terhubung ke server atau ukuran file terlalu besar.');
            }

            const result = await response.json();

            if (result.success) {
                clearDraft();
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    html: `Sampaikan Kode Unik ini kepada pihak Warehouse:<br><br><b style="font-size:30px; color:#EE2E24;">${result.kodeUnik}</b>`,
                    confirmButtonText: 'Kembali ke Dasbor',
                    allowOutsideClick: false
                }).then(() => window.location.href = '/teknisi/dashboard');
            } else {
                Swal.fire('Gagal', result.message, 'error');
                btn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-2"></i> SIMPAN &amp; BUAT KODE BAST';
                btn.disabled = false;
            }
        } catch (error) {
            console.error(error);
            Swal.fire('Error Sistem', error.message + ' Silakan cek terminal VS Code Anda.', 'error');
            btn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-2"></i> SIMPAN &amp; BUAT KODE BAST';
            btn.disabled = false;
        }
    }
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.anim-up').forEach(function (el, i) {
            el.style.animationDelay = (i * 70) + 'ms';
        });
        loadDraft();
    });
</script>

</body>
</html>
