<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Teknisi - Telkom Akses</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #f4f7f6; }
        .navbar-custom { background: linear-gradient(135deg, #EE2E24 0%, #b31217 100%); }
        .card-panel { background: #fff; border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.02); }
        .table th { background-color: #f8fafc; font-size: 0.85rem; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; }
        .badge-completed { background-color: #dcfce7; color: #166534; padding: 6px 14px; border-radius: 20px; font-weight: 500; font-size: 0.75rem; }
        .badge-pending { background-color: #fef9c3; color: #854d0e; padding: 6px 14px; border-radius: 20px; font-weight: 500; font-size: 0.75rem; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3 shadow-sm mb-4">
    <div class="container px-4">
        <a class="navbar-brand fw-bold" href="#"><i class="bi bi-tools me-2"></i> Panel Teknisi (Pemberi)</a>
        <div class="d-flex align-items-center">
            <a href="/logout" class="btn btn-sm btn-light text-danger fw-bold rounded-pill px-3 shadow-sm">Logout</a>
        </div>
    </div>
</nav>

<div class="container mb-5">
    
    <!-- Header Aksi Cepat -->
    <div class="card-panel p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-inbox-fill text-danger me-2"></i> Inbox & Monitoring Status BAST</h4>
                <p class="text-muted small mb-0">Pantau apakah dokumen pengiriman perangkat Anda sudah disetujui oleh Warehouse.</p>
            </div>
            <a href="/teknisi/input" class="btn btn-danger fw-bold rounded-pill px-4 py-2 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Buat BAST Baru
            </a>
        </div>
    </div>

    <!-- Tabel Monitoring / Inbox Status BAST -->
    <div class="card-panel p-4">
        <h5 class="fw-bold mb-3 text-danger"><i class="bi bi-list-check me-2"></i> Riwayat & Status Persetujuan Warehouse</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Kode BAST</th>
                        <th>Tanggal</th>
                        <th>Lokasi STO</th>
                        <th>Nama Teknisi</th>
                        <th>Penerima (WH)</th>
                        <th>Status Approval</th>
                        <th class="text-center">Aksi Dokumen</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (data.length === 0) { %>
                        <tr><td colspan="7" class="text-center py-5 text-muted">Belum ada riwayat pengiriman BAST.</td></tr>
                    <% } %>
                    <% data.forEach(row => { %>
                    <tr>
                        <td><span class="fw-bold text-danger font-monospace"><%= row.kode_unik %></span></td>
                        <td><%= row.tanggal %></td>
                        <td><%= row.loksto %></td>
                        <td><%= row.teknisi_nama %></td>
                        <td><span class="badge bg-light text-dark border"><%= row.wh_nama || 'Belum Ditentukan' %></span></td>
                        <td>
    <% if (row.status === 'COMPLETED') { %>
        <span class="badge-completed"><i class="bi bi-check-circle-fill me-1"></i> Approved (Selesai)</span>
    <% } else if (row.status === 'REJECTED') { %>
        <span class="badge bg-danger text-white px-2 py-1 rounded-pill" style="font-size: 0.75rem;"><i class="bi bi-x-circle-fill me-1"></i> Ditolak WH</span>
        <div class="small text-muted mt-1">Alasan: <%= row.alasan_tolak || '-' %></div>
    <% } else { %>
        <span class="badge-pending"><i class="bi bi-clock-fill me-1"></i> Menunggu Approval WH</span>
    <% } %>
</td>
<td class="text-center">
    <% if (row.status === 'COMPLETED') { %>
        <a href="/bast/cetak/<%= row.kode_unik %>" target="_blank" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-medium shadow-sm">
            <i class="bi bi-printer-fill me-1"></i> Lihat / Cetak PDF
        </a>
    <% } else if (row.status === 'REJECTED') { %>
        <span class="text-danger small fw-bold"><i class="bi bi-dash-circle"></i> Batal</span>
    <% } else { %>
        <span class="text-muted small italic">Dalam Proses WH</span>
    <% } %>
</td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>